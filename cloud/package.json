{
  "name": "casamiga-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "API de sincronización y versión web de Casa Miga POS (Vercel Functions + Neon).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p .",
    "dev:web": "node --import tsx scripts/dev-web.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 \"test-browser/*.test.ts\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@vercel/blob": "^1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^24.19.1",
    "playwright-core": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
