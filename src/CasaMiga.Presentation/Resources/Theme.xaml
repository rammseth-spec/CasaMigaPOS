 <!-- Menú lateral: riel blanco con ícono arriba y nombre corto abajo; la sección activa en verde suave. -->
 <Style x:Key="SidebarGroupText" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
  <Setter Property="FontSize" Value="10"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="0,12,0,4"/><Setter Property="Opacity" Value="0.8"/>
 </Style>
 <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="58"/><Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="2,7,2,6"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name),RelativeSource={RelativeSource Self}}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border Background="{TemplateBinding Background}" CornerRadius="12">
    <Grid>
     <Border x:Name="HoverOverlay" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="12" IsHitTestVisible="False"/>
     <StackPanel x:Name="NavGrid" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
      <Viewbox Width="24" Height="24" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="NavIcon" Data="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
      <ContentPresenter x:Name="NavLabel" Margin="0,4,0,0" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True">
       <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/></Style></ContentPresenter.Resources>
      </ContentPresenter>
     </StackPanel>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverOverlay" Property="Opacity" Value="0.07"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverOverlay" Property="Opacity" Value="0.13"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- Gráficas: verde Hoja de Aguacate (#4A5D4E) y tintes del mismo color; el café se reserva para el logotipo. -->
 <SolidColorBrush x:Key="ChartBrush" Color="{StaticResource CasaMigaAvocadoLeafGreen}"/>
 <SolidColorBrush x:Key="ChartSoftBrush" Color="#664A5D4E"/>
 <SolidColorBrush x:Key="ChartTrackBrush" Color="#1A4A5D4E"/>

 <!-- Pantalla de acceso: fichas de estado sobre el panel verde (crema translúcida). Se ocultan si no tienen datos. -->
 <Style x:Key="SignInChip" TargetType="Border"><Setter Property="Background" Value="#26FDF8EF"/><Setter Property="BorderBrush" Value="#40FDF8EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,8,6,0"/>
  <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
 <Style x:Key="SignInChipText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource NaturalBackgroundBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>

 <!-- Filtros y pestañas como píldoras: blanca con línea; la elegida en tinta oscura con texto blanco (Tag=True). -->
 <Style x:Key="SectionTabButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
  <Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Border x:Name="Pill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20"/>
    <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="20" Opacity="0" IsHitTestVisible="False"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers>
 </Style>
 <!-- Control segmentado (dentro de un Border con estilo SegmentedTrack): la opción elegida es blanca con sombra (Tag=True). -->
 <Style x:Key="SegmentedTrack" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="4"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
 <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
  <Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Border x:Name="Chosen" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Opacity="0">
     <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.14" Color="#2A1E15"/></Border.Effect>
    </Border>
    <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="9" Opacity="0" IsHitTestVisible="False"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Grid>
   <ControlTemplate.Triggers>
