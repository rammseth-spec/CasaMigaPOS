<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="CanvasBrush" Color="#FFF7EA"/><SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="InkBrush" Color="#362D28"/><SolidColorBrush x:Key="BrandBrush" Color="#75432E"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#67574C"/><SolidColorBrush x:Key="BorderBrush" Color="#C7B8A8"/>
 <SolidColorBrush x:Key="SuccessBrush" Color="#235F44"/><SolidColorBrush x:Key="ErrorBrush" Color="#A12424"/>
 <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-4" Stroke="{DynamicResource BrandBrush}" StrokeThickness="2" StrokeDashArray="2,2"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Window"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
 <Style TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="Button">
  <Setter Property="MinHeight" Value="52"/><Setter Property="MinWidth" Value="140"/><Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="20,12"/>
  <Setter Property="Background" Value="{DynamicResource BrandBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox"><Setter Property="MinHeight" Value="52"/><Setter Property="FontSize" Value="22"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="52"/><Setter Property="FontSize" Value="22"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
 <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="52"/><Setter Property="FontSize" Value="20"/><Setter Property="Padding" Value="8"/></Style>
 <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="52"/><Setter Property="FontSize" Value="18"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8"/></Style>
 <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="RowHeight" Value="52"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="FontSize" Value="17"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="CanUserSortColumns" Value="False"/></Style>
 <Style x:Key="ProductTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="180"/><Setter Property="MinHeight" Value="112"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Padding" Value="12"/></Style>
 <Style x:Key="QuantityButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="52"/><Setter Property="Width" Value="52"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="24"/></Style>
</ResourceDictionary>
