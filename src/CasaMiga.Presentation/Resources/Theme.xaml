<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <!-- Identidad oficial documentada en CasaMiga_MANUAL_FINAL(1).pdf. -->
 <Color x:Key="CasaMigaArtisanBread">#4B2E19</Color><Color x:Key="CasaMigaNaturalBackground">#FDF8EF</Color><Color x:Key="CasaMigaSoftWheat">#A67C52</Color>
 <!-- Equivalencia digital BEREL 405N autorizada por el usuario el 27-09-2026. -->
 <Color x:Key="CasaMigaAvocadoLeafGreen">#4A5D4E</Color>
 <!-- Rediseño A «Claro y cálido» (07-10-2026, elegido por el usuario): fondo cálido claro, superficies blancas con líneas finas,
      Hoja de Aguacate como único color de acción y texto casi negro con tono café. El café Pan Artesanal queda para el logotipo. -->
 <Color x:Key="BackgroundColor">#F5F3EF</Color><Color x:Key="SurfaceColor">#FFFFFFFF</Color><Color x:Key="SurfaceSecondaryColor">#F3F0EA</Color>
 <Color x:Key="PrimaryColor">#4A5D4E</Color><Color x:Key="PrimaryHoverColor">#3D4E41</Color><Color x:Key="PrimarySoftColor">#E7EEE8</Color><Color x:Key="PrimaryPressedColor">#33433A</Color>
 <Color x:Key="TextPrimaryColor">#2A1E15</Color><Color x:Key="TextSecondaryColor">#6B5F56</Color><Color x:Key="BorderColor">#E2DCD2</Color>
 <Color x:Key="SuccessColor">#2F7A4A</Color><Color x:Key="WarningColor">#8B6440</Color><Color x:Key="ErrorColor">#B42318</Color><Color x:Key="DisabledColor">#ECE8E1</Color>
 <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/><SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
 <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}"/><SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
 <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/><SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
 <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
 <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
 <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/><SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
 <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/><SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
 <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
 <!-- Validación de formularios (no es color de marca): verde legible sobre blanco, contraste 5:1. El rojo reutiliza ErrorColor. -->
 <Color x:Key="ValidColor">#2E7D32</Color><SolidColorBrush x:Key="DividerBrush" Color="#F0ECE5"/><SolidColorBrush x:Key="ValidBrush" Color="{StaticResource ValidColor}"/>
 <SolidColorBrush x:Key="WheatBrush" Color="{StaticResource CasaMigaSoftWheat}"/>
 <SolidColorBrush x:Key="NaturalBackgroundBrush" Color="{StaticResource CasaMigaNaturalBackground}"/>
 <!-- Tonos de apoyo del rediseño: líneas finas, rellenos, texto de acento y fondos suaves de estado. -->
 <SolidColorBrush x:Key="HairlineBrush" Color="#ECE7DF"/>
 <SolidColorBrush x:Key="FillHoverBrush" Color="#EAE6DF"/>
 <SolidColorBrush x:Key="AccentTextBrush" Color="#3D4E41"/>
 <SolidColorBrush x:Key="ErrorHoverBrush" Color="#8F1C13"/>
 <SolidColorBrush x:Key="WarningSoftBrush" Color="#F6EEE3"/><SolidColorBrush x:Key="WarningTextBrush" Color="#6E4E2E"/>
 <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E9F4EC"/><SolidColorBrush x:Key="ErrorSoftBrush" Color="#FDECEA"/>
 <SolidColorBrush x:Key="StatusIdleBrush" Color="#B4AAA0"/>
 <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
 <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

 <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource BackgroundColor}"/><SolidColorBrush x:Key="CardBrush" Color="{StaticResource SurfaceColor}"/>
 <SolidColorBrush x:Key="InkBrush" Color="{StaticResource TextPrimaryColor}"/><SolidColorBrush x:Key="BrandBrush" Color="{StaticResource CasaMigaArtisanBread}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextSecondaryColor}"/>
 <SolidColorBrush x:Key="AvocadoLeafBrush" Color="{StaticResource CasaMigaAvocadoLeafGreen}"/>
 <BooleanToVisibilityConverter x:Key="VisibleWhen"/>

 <!-- Foco de teclado: anillo continuo Hoja de Aguacate (antes punteado). -->
 <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" RadiusX="12" RadiusY="12"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Window"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontFamily" Value="{StaticResource TextFont}"/></Style>
 <!-- Inherit Foreground: a global setter overrides the white inherited from buttons. -->
 <Style TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
 <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <!-- Importes: cifras de ancho fijo para que no «bailen» al cambiar. -->
 <Style x:Key="AmountText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
 <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,8"/><Setter Property="Visibility" Value="Collapsed"/>
  <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
  <Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>
 <!-- Tarjetas: blancas, línea fina y esquinas suaves; sin marcos cafés. -->
 <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/></Style>
 <Style x:Key="StatusPill" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="StatusDot" TargetType="Ellipse"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Fill" Value="{DynamicResource StatusIdleBrush}"/></Style>
 <!-- Contador redondo (piezas en la charola o en el ticket). -->
 <Style x:Key="CountBadge" TargetType="Border"><Setter Property="MinWidth" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="9,0"/><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="6"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
 <Style x:Key="CountBadgeText" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

 <!-- Botones. Principal: Hoja de Aguacate. Secundario: blanco con línea. Discreto: sin fondo. Destructivo: rojo. -->
 <ControlTemplate x:Key="SolidButtonTemplate" TargetType="Button">
  <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DisabledBrush}"/><Setter TargetName="Surface" Property="Opacity" Value="1"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="DangerButtonTemplate" TargetType="Button">
  <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ErrorHoverBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ErrorHoverBrush}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DisabledBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DisabledBrush}"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <!-- Secundario y discreto: al pasar el mouse, una capa del color del texto muy tenue (oscurece fondos claros y aclara fondos oscuros). -->
 <ControlTemplate x:Key="OutlineButtonTemplate" TargetType="Button">
  <Grid>
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True"/>
   <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.12"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value="0.5"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <Style TargetType="Button">
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="MinHeight" Value="46"/><Setter Property="MinWidth" Value="116"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,10"/>
  <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
  <Setter Property="Template" Value="{StaticResource SolidButtonTemplate}"/>
 </Style>
 <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Template" Value="{StaticResource OutlineButtonTemplate}"/></Style>
 <Style x:Key="SelectionRequiredButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Style.Triggers><Trigger Property="Tag" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource ErrorBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/><Setter Property="Template" Value="{StaticResource DangerButtonTemplate}"/></Style>
 <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
 <!-- Botón de sólo ícono (la geometría va en Tag). Siempre con nombre accesible. -->
 <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
  <Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{Binding Tag,RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></DataTemplate></Setter.Value></Setter>
 </Style>
