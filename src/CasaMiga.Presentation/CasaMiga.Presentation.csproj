<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><OutputType>WinExe</OutputType><ApplicationIcon>Assets\CasaMiga.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup><ProjectReference Include="../CasaMiga.Infrastructure/CasaMiga.Infrastructure.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/CasaMigaLogo.png" /><Resource Include="Assets/CasaMiga.ico" /><Resource Include="Assets/Nav/*.png" /></ItemGroup>
  <!-- Catálogo de Casa Miga con sus fotos provisionales (IA): viajan junto al programa y en el instalador, en catalogo\, para «Cargar catálogo Casa Miga». -->
  <ItemGroup>
    <Content Include="../../docs/catalog/catalogo-autorizado-v2.csv" Link="catalogo/catalogo-autorizado-v2.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/catalog/renombres.json" Link="catalogo/renombres.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/catalog-provisional-ia/*.jpg" Link="catalogo/fotos/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/catalog-provisional-ia/manifest.json" Link="catalogo/fotos/manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(CasaMigaReviewBuild)' != ''">
    <AssemblyMetadata Include="CasaMiga.ReviewBuild" Value="$(CasaMigaReviewBuild)" />
  </ItemGroup>
</Project>
