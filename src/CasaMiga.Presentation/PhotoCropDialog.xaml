<Window x:Class="CasaMiga.Presentation.PhotoCropDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Casa Miga · Ajustar foto" Width="900" Height="720" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" ShowInTaskbar="False">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="Ajustar fotografía" Style="{StaticResource PageTitleText}"/><TextBlock Text="Arrastra el cuadro para moverlo. Arrastra la esquina inferior derecha para cambiar su tamaño. El archivo original no se modifica." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
   <Grid x:Name="PreviewHost" ClipToBounds="True" SizeChanged="PreviewSizeChanged">
    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="OverlayMouseDown" MouseMove="OverlayMouseMove" MouseLeftButtonUp="OverlayMouseUp"><Rectangle x:Name="CropRectangle" Stroke="{DynamicResource WheatBrush}" StrokeThickness="4" Fill="#18FFFFFF" IsHitTestVisible="False"/><Rectangle x:Name="ResizeHandle" Width="22" Height="22" Fill="{DynamicResource AvocadoLeafBrush}" Stroke="White" StrokeThickness="2" Cursor="SizeNWSE"/></Canvas>
   </Grid>
  </Border>
  <Expander Grid.Row="2" Header="Ajuste avanzado por coordenadas" Margin="0,12,0,12"><StackPanel Margin="0,10,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Posición horizontal"/><Slider Minimum="0" Maximum="{Binding MaximumX}" Value="{Binding X,Mode=TwoWay}"/><TextBlock Text="{Binding X,StringFormat=X: {0:F0} px}" Style="{StaticResource CaptionText}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Posición vertical"/><Slider Minimum="0" Maximum="{Binding MaximumY}" Value="{Binding Y,Mode=TwoWay}"/><TextBlock Text="{Binding Y,StringFormat=Y: {0:F0} px}" Style="{StaticResource CaptionText}"/></StackPanel>
   </Grid>
   <StackPanel Margin="0,12,0,0"><TextBlock Text="Tamaño del recorte"/><Slider Minimum="{Binding MinimumEdge}" Maximum="{Binding MaximumEdge}" Value="{Binding Edge,Mode=TwoWay}"/><TextBlock Text="{Binding Edge,StringFormat=Lado: {0:F0} px}" Style="{StaticResource CaptionText}"/></StackPanel>
  </StackPanel></Expander>
  <DockPanel Grid.Row="3"><TextBlock x:Name="DimensionsLabel" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="CancelClick" Margin="0,0,12,0"/><Button Content="Usar este recorte" Click="AcceptClick"/></StackPanel></DockPanel>
 </Grid>
</Window>
