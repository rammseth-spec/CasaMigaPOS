<UserControl x:Class="CasaMiga.Presentation.CashHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="0,14,0,0">
  <Grid Visibility="{Binding ShowsCashDashboard,Converter={StaticResource VisibleWhen}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>
   <StackPanel Grid.Row="1" Margin="0,0,0,8">
    <TextBlock Text="Cierres anteriores" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="Sólo lectura · Cierres de esta caja" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
    <TextBlock Text="Todavía no hay cierres registrados en esta caja." Margin="0,6,0,0" Visibility="{Binding HasNoCashClosures,Converter={StaticResource VisibleWhen}}"/>
   </StackPanel>
  <DataGrid x:Name="CashHistoryGrid" Grid.Row="2" ItemsSource="{Binding CashClosures}" SelectedItem="{Binding SelectedCashClosure}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="170" MinWidth="0" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Auto" SelectionMode="Single" AutomationProperties.Name="Cierres anteriores">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Cierre" Binding="{Binding Date}" Width="1.1*" MinWidth="130" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/>
    <DataGridTextColumn Header="Caja" Binding="{Binding Terminal}" Width="*" MinWidth="130" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/>
    <DataGridTextColumn Header="Responsable" Binding="{Binding Owner}" Width="*" MinWidth="130" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/>
    <DataGridTextColumn Header="Esperado" Binding="{Binding Expected}" Width="0.85*" MinWidth="100" ElementStyle="{StaticResource CasaMigaTableMoneyTextStyle}" HeaderStyle="{StaticResource CasaMigaTableCenteredHeaderStyle}"/>
    <DataGridTextColumn Header="Contado" Binding="{Binding Counted}" Width="0.85*" MinWidth="100" ElementStyle="{StaticResource CasaMigaTableMoneyTextStyle}" HeaderStyle="{StaticResource CasaMigaTableCenteredHeaderStyle}"/>
    <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference}" Width="1.15*" MinWidth="125" ElementStyle="{StaticResource CasaMigaTableMoneyTextStyle}" HeaderStyle="{StaticResource CasaMigaTableCenteredHeaderStyle}"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel x:Name="CashHistoryFooter" Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Bottom" AutomationProperties.Name="Paginación de cierres">
   <TextBlock Text="{Binding CashHistorySummary}" VerticalAlignment="Center" Margin="0,0,16,8"/>
   <Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding CanPreviousCashHistory}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
   <Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding CanNextCashHistory}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
   <Button Content="Ver cierre" Click="DetailClick" Margin="0,0,0,8"/>
  </WrapPanel>
  </Grid>
  <Border x:Name="CashClosureDetailPanel" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" VerticalAlignment="Top" Visibility="{Binding HasCashClosureDetail,Converter={StaticResource VisibleWhen}}">
   <StackPanel>
    <TextBlock Text="Detalle del cierre" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="Sólo lectura" Style="{StaticResource CaptionText}" Margin="0,2,0,14"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14">
      <StackPanel><TextBlock Text="Identificación" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding CashClosureDetail.Terminal,StringFormat=Caja: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.OpenedDate,StringFormat=Apertura: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.OpenedBy,StringFormat=Abierta por: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.ClosedDate,StringFormat=Cierre: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.ClosedBy,StringFormat=Cerrada por: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.CountedBy,StringFormat=Conteo realizado por: {0}}"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14">
      <StackPanel><TextBlock Text="Resumen financiero" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding CashClosureDetail.OpeningFund,StringFormat=Fondo inicial: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.CashSales,StringFormat=Ventas en efectivo: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.Expected,StringFormat=Efectivo esperado: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.Counted,StringFormat=Efectivo contado: {0}}"/>
       <TextBlock Text="{Binding CashClosureDetail.Difference}" FontWeight="SemiBold" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14">
      <StackPanel><TextBlock Text="Nota de discrepancia" FontWeight="SemiBold"/><TextBlock Text="{Binding CashClosureDetail.Note}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
     </Border>
    </Grid>
    <Button Content="Volver" Click="HideClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
