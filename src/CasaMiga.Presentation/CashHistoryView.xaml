<UserControl x:Class="CasaMiga.Presentation.CashHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,22,0,0">
  <StackPanel Visibility="{Binding ShowsCashDashboard,Converter={StaticResource VisibleWhen}}"><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>
  <TextBlock Text="Cierres anteriores" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Sólo lectura · Cierres de esta caja" Style="{StaticResource CaptionText}" Margin="0,4,0,12"/>
  <TextBlock Text="Todavía no hay cierres registrados en esta caja." Margin="0,8" Visibility="{Binding HasNoCashClosures,Converter={StaticResource VisibleWhen}}"/>
  <DataGrid ItemsSource="{Binding CashClosures}" SelectedItem="{Binding SelectedCashClosure}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="210" MinWidth="0" HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" AutomationProperties.Name="Cierres anteriores">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Cierre" Binding="{Binding Date}" Width="155"/>
    <DataGridTextColumn Header="Caja" Binding="{Binding Terminal}" Width="*"/>
    <DataGridTextColumn Header="Responsable" Binding="{Binding Owner}" Width="*"/>
    <DataGridTextColumn Header="Esperado" Binding="{Binding Expected}" Width="105"/>
    <DataGridTextColumn Header="Contado" Binding="{Binding Counted}" Width="105"/>
    <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference}" Width="180"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Margin="0,10,0,0">
   <TextBlock Text="{Binding CashHistorySummary}" VerticalAlignment="Center" Margin="0,0,16,8"/>
   <Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding CanPreviousCashHistory}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
   <Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding CanNextCashHistory}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
   <Button Content="Ver cierre" Click="DetailClick" Margin="0,0,0,8"/>
  </WrapPanel>
  </StackPanel>
  <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" Padding="18" Margin="0,12,0,0" Visibility="{Binding HasCashClosureDetail,Converter={StaticResource VisibleWhen}}">
   <StackPanel><TextBlock Text="Detalle del cierre · sólo lectura" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding CashClosureDetail.Details}" TextWrapping="Wrap"/>
    <Button Content="Cerrar detalle" Click="HideClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
