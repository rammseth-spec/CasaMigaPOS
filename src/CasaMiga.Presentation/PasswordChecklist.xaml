<UserControl x:Class="CasaMiga.Presentation.PasswordChecklist" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" IsTabStop="False">
 <ItemsControl x:Name="Items" Focusable="False" AutomationProperties.Name="Requisitos de la contraseña">
  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate>
   <DataTemplate>
    <StackPanel Orientation="Horizontal" Margin="0,2,12,2" AutomationProperties.Name="{Binding Spoken}">
     <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontWeight="Bold" FontSize="14" Width="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
     <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
    <DataTemplate.Triggers>
     <DataTrigger Binding="{Binding State}" Value="Valid"><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ValidBrush}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ValidBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding State}" Value="Invalid"><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
    </DataTemplate.Triggers>
   </DataTemplate>
  </ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
