<Window x:Class="CasaMiga.Presentation.AppDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="520" WindowStartupLocation="CenterOwner" FontFamily="{StaticResource TextFont}" Foreground="{DynamicResource TextPrimaryBrush}" UseLayoutRounding="True">
 <!-- Aviso propio del rediseño A: tarjeta blanca con sombra en lugar de la ventana gris de Windows. -->
 <Border Margin="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="24,22,24,20" Effect="{DynamicResource ShadowDialog}">
  <StackPanel>
   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Badge" Width="38" Height="38" CornerRadius="19" Margin="0,0,14,0" VerticalAlignment="Top" Visibility="Collapsed">
     <TextBlock x:Name="BadgeText" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
    </Border>
    <TextBlock x:Name="Heading" Grid.Column="1" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </Grid>
   <TextBlock x:Name="Body" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" LineHeight="22"/>
   <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"/>
  </StackPanel>
 </Border>
</Window>
