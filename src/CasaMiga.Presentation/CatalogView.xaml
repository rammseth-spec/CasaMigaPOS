<UserControl x:Class="CasaMiga.Presentation.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="CatalogKeyDown">
 <StackPanel IsEnabled="{Binding Ready}">
  <TextBlock Text="DEMO / DESARROLLO · Los precios de prueba no son precios comerciales." Foreground="{DynamicResource BrandBrush}" FontSize="16" Visibility="{Binding IsDevelopment,Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12"/>
  <WrapPanel Margin="0,0,0,16"><Button Content="Productos" Style="{StaticResource SectionTabButton}" Tag="{Binding IsProducts}" Click="ProductsClick" Margin="0,0,12,8"/><Button Content="Categorías" Style="{StaticResource SectionTabButton}" Tag="{Binding IsCategories}" Click="CategoriesClick" Margin="0,0,0,8"/></WrapPanel>
  <StackPanel Visibility="{Binding IsCategories,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Categorías · incluye inactivas" Margin="0,0,0,8"/>
   <DataGrid x:Name="CategoryList" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="190" AutomationProperties.Name="Categorías">
    <DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Name,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Orden" Binding="{Binding SortOrder,Mode=OneWay}" Width="100"/><DataGridCheckBoxColumn Header="Activa" Binding="{Binding IsActive,Mode=OneWay}" Width="90"/></DataGrid.Columns>
   </DataGrid>
   <WrapPanel Margin="0,16,0,0"><Button Content="Nueva categoría" Click="NewCategoryClick" IsEnabled="{Binding CanCreateCategory}" Margin="0,0,12,8"/><Button Content="Editar categoría" Click="EditCategoryClick" IsEnabled="{Binding CanEditCategory}" Margin="0,0,12,8"/><Button Content="Activar / desactivar" Click="ToggleCategoryClick" IsEnabled="{Binding CanToggleCategory}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProducts,Converter={StaticResource VisibleWhen}}">
   <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Buscar nombre o SKU" FontSize="16"/><TextBox x:Name="SearchBox" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Buscar nombre o SKU"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Filtrar por categoría" FontSize="16"/><ComboBox ItemsSource="{Binding Filters}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding FilterCategoryId}" AutomationProperties.Name="Filtrar por categoría"/></StackPanel>
   </Grid>
   <WrapPanel Margin="0,0,0,10"><CheckBox Content="Mostrar inactivos" IsChecked="{Binding ShowInactive}" Margin="0,0,16,0"/><Button Content="Buscar / aplicar" Click="SearchClick"/></WrapPanel>
   <DataGrid x:Name="ProductList" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Height="190" AutomationProperties.Name="Productos">
    <DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/><DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="150"/><DataGridTextColumn Header="Precio" Binding="{Binding Price}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/></DataGrid.Columns>
   </DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Nuevo producto" Click="NewProductClick" IsEnabled="{Binding CanCreateProduct}" Margin="0,0,12,8"/><Button Content="Editar producto" Click="EditProductClick" IsEnabled="{Binding CanEditProduct}" Margin="0,0,12,8"/><Button Content="Activar / desactivar" Click="ToggleProductClick" IsEnabled="{Binding CanToggleProduct}" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock Text="{Binding PageLabel}" FontSize="15" Margin="0,6,0,8"/><WrapPanel><Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding HasPrevious}" Margin="0,0,12,8"/><Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding HasNext}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsCategoryEditor,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{Binding EditorTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock Text="Nombre"/><TextBox x:Name="CategoryName" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nombre de categoría" Margin="0,4,0,12"/>
   <TextBlock Text="Descripción opcional"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="Descripción de categoría" Margin="0,4,0,12"/>
   <TextBlock Text="Orden"/><TextBox Text="{Binding SortOrder,UpdateSourceTrigger=PropertyChanged}" MaxLength="11" AutomationProperties.Name="Orden de categoría" Margin="0,4,0,16"/>
   <WrapPanel><Button Content="Cancelar" Click="CancelClick" Margin="0,0,12,8"/><Button Content="Guardar categoría" Click="SaveClick" IsEnabled="{Binding CanSave}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProductEditor,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{Binding EditorTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="180" Height="180" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" ClipToBounds="True">
      <Grid><Image Source="{Binding CurrentPhoto}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasCurrentPhoto,Converter={StaticResource VisibleWhen}}"/>
       <Grid Visibility="{Binding HasNoCurrentPhoto,Converter={StaticResource VisibleWhen}}"><Path Data="M4,5 L16,5 18,8 18,17 2,17 2,8 Z M7,5 L8.5,2 11.5,2 13,5 M10,9 A3,3 0 1 1 9.99,9" Stroke="{DynamicResource WheatBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="52" Height="52"/><TextBlock Text="Sin foto" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"/></Grid>
      </Grid>
     </Border>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Fotografía del producto" Style="{StaticResource SectionTitleText}"/>
      <TextBlock Text="{Binding CurrentPhotoStatus}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,12"/>
      <TextBlock Text="Tipo de fotografía"/>
      <ComboBox SelectedValue="{Binding PhotoProvenance}" SelectedValuePath="Tag" Margin="0,4,0,12" IsEnabled="{Binding CanManagePhoto}"><ComboBoxItem Content="Foto real" Tag="REAL"/><ComboBoxItem Content="Foto provisional" Tag="PROVISIONAL"/></ComboBox>
      <WrapPanel><Button Content="Agregar / cambiar foto" Click="ChangePhotoClick" IsEnabled="{Binding CanManagePhoto}" Margin="0,0,12,8"/><Button Content="Quitar foto" Click="RemovePhotoClick" IsEnabled="{Binding CanRemovePhoto}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="Guarda primero los productos nuevos; después podrás asociar su fotografía." Style="{StaticResource CaptionText}" Visibility="{Binding CannotManagePhoto,Converter={StaticResource VisibleWhen}}"/>
     </StackPanel>
    </Grid>
   </Border>
   <TextBlock Text="Nombre"/><TextBox x:Name="ProductName" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Nombre de producto" Margin="0,4,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,12"><TextBlock Text="Categoría"/><ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Id" SelectedValue="{Binding ProductCategoryId}" AutomationProperties.Name="Categoría del producto" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="Precio MXN · punto decimal"/><TextBox Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Precio MXN" Margin="0,4,0,0"/></StackPanel>
   </Grid>
   <TextBlock Text="SKU opcional"/><TextBox Text="{Binding Sku,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="SKU" Margin="0,4,0,12"/>
   <TextBlock Text="Descripción opcional"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="Descripción de producto" Margin="0,4,0,8"/>
   <CheckBox Content="Controlar inventario en el futuro (sólo metadato)" IsChecked="{Binding TrackInventory}" Margin="0,0,0,12"/>
   <WrapPanel><Button Content="Cancelar" Click="CancelClick" Margin="0,0,12,8"/><Button Content="Guardar producto" Click="SaveClick" IsEnabled="{Binding CanSave}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0"/>
  <Button Content="Cargar catálogo DEMO (requiere vacío)" Click="DemoClick" Visibility="{Binding IsDevelopment,Converter={StaticResource VisibleWhen}}" Margin="0,20,0,0"/>
 </StackPanel>
</UserControl>
