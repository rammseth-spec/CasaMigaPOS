<UserControl x:Class="CasaMiga.Presentation.PosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="PosKeyDown" IsVisibleChanged="PosVisibilityChanged">
 <Grid IsEnabled="{Binding Ready}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="420"/><ColumnDefinition Width="3*" MinWidth="300"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" Text="DEMO · precios de prueba" Foreground="{DynamicResource BrandBrush}" FontSize="14" Visibility="{Binding IsDevelopment,Converter={StaticResource VisibleWhen}}"/><TextBlock Text="Venta temporal hasta confirmar el cobro" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/></DockPanel>
  <Grid Grid.Row="2" Margin="0,0,12,6" MaxHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><TextBlock Text="Buscar nombre o SKU" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Background="Transparent" x:Name="SearchInput" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Buscar producto por nombre o SKU" ToolTip="Buscar nombre o SKU"/></Grid>
   <Button Grid.Column="1" Content="Buscar" Click="SearchClick" Margin="8,0,0,0" MinWidth="96"/>
   <Button Grid.Column="2" Content="× Limpiar" Click="ClearSearchClick" Margin="8,0,0,0" MinWidth="104" Style="{StaticResource SecondaryButton}" Visibility="{Binding HasSearch,Converter={StaticResource VisibleWhen}}"/>
  </Grid>
  <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,12,8">
   <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Selected}" CommandParameter="{Binding Id}" Style="{StaticResource SectionTabButton}" Click="CategoryClick" Margin="0,0,8,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <Grid Grid.Row="4">
   <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Productos · pulsa una tarjeta para agregar" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <Grid Grid.Row="1">
     <TextBlock Text="{Binding EmptyProductsMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="16" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoProducts,Converter={StaticResource VisibleWhen}}"/>
     <ScrollViewer x:Name="ProductCatalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Products}" IsEnabled="{Binding CanOperate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource ProductTile}" Tag="{Binding Id}" Click="ProductClick" IsEnabled="{Binding IsActive}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="48"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" ClipToBounds="True">
         <Grid>
          <Image Source="{Binding Photo}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasPhoto,Converter={StaticResource VisibleWhen}}"/>
          <Grid Visibility="{Binding IsFallback,Converter={StaticResource VisibleWhen}}">
           <Path Data="M4,5 L16,5 18,8 18,17 2,17 2,8 Z M7,5 L8.5,2 11.5,2 13,5 M10,9 A3,3 0 1 1 9.99,9" Stroke="{DynamicResource WheatBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="48" Height="48" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
           <TextBlock Text="Sin imagen" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
          </Grid>
         </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Left" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="2,7,2,0" VerticalAlignment="Top"/>
        <TextBlock Grid.Row="2" Text="{Binding Price}" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" TextAlignment="Left" Margin="2,0" VerticalAlignment="Center"/>
       </Grid>
      </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel DockPanel.Dock="Right"><Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding Previous}" MinWidth="100"/><Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding Next}" MinWidth="100" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding PageLabel}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
   </Grid>
  </Grid>
   <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AvocadoLeafBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tu carrito" FontSize="22" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding CartSummary}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="10,0,0,2" AutomationProperties.Name="Resumen del carrito"/></Grid>
     <Grid Grid.Row="1"><TextBlock Text="Carrito vacío. Agrega un producto para comenzar." Foreground="{DynamicResource MutedBrush}" Margin="8,16" Visibility="{Binding IsEmpty,Converter={StaticResource VisibleWhen}}"/>
      <ScrollViewer x:Name="CartLinesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Partidas del carrito"><ItemsControl x:Name="CartLinesList" ItemsSource="{Binding Lines}" IsEnabled="{Binding CanModifyCart}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MinHeight="82" Padding="0,4" AutomationProperties.Name="{Binding Name}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="40"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17" VerticalAlignment="Top" Margin="0,0,10,0"/>
         <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="17" FontWeight="Bold" VerticalAlignment="Top"/>
         <TextBlock Grid.Row="1" Text="{Binding UnitPrice}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Button Content="−" Tag="{Binding Id}" Click="DecreaseClick" IsEnabled="{Binding CanDecrease}" Style="{StaticResource QuantityButton}" ToolTip="Disminuir cantidad" AutomationProperties.Name="Disminuir cantidad"/><TextBlock Text="{Binding Quantity}" Width="34" TextAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" AutomationProperties.Name="Cantidad"/><Button Content="+" Tag="{Binding Id}" Click="IncreaseClick" Style="{StaticResource QuantityButton}" ToolTip="Incrementar cantidad" AutomationProperties.Name="Incrementar cantidad"/><Button Tag="{Binding Id}" Click="RemoveClick" Style="{StaticResource CartRemoveButton}" ToolTip="Eliminar producto del carrito" AutomationProperties.Name="Eliminar producto del carrito"><Path Data="M3,5 L17,5 M7,5 L8,2 12,2 13,5 M5,6 L6,18 14,18 15,6 M8,8 L8.5,15 M12,8 L11.5,15" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"/></Button></StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </Grid>
     <Grid Grid.Row="2" Margin="0,5,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock Text="Subtotal" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Subtotal}" FontSize="13" Margin="5,0,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><TextBlock Text="TOTAL" FontSize="14" FontWeight="SemiBold" Margin="0,0,7,2"/><TextBlock Text="{Binding Total}" FontSize="22" FontWeight="Bold"/></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="6"/><ColumnDefinition Width="72"/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Limpiar" Click="ClearClick" IsEnabled="{Binding CanCheckout}" MinWidth="68" MinHeight="40" Height="40" Padding="6" FontSize="13" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Content="Cobrar" Click="CheckoutClick" IsEnabled="{Binding CanCheckout}" MinWidth="68" MinHeight="40" Height="40" Padding="6" FontSize="13" ToolTip="Confirmar venta sin imprimir ticket"/><Button Grid.Column="4" Content="Cobrar + imprimir" Click="CheckoutAndPrintClick" IsEnabled="{Binding CanCheckout}" MinWidth="104" MinHeight="40" Height="40" Padding="6" FontSize="12" ToolTip="Confirmar venta e imprimir ticket" AutomationProperties.Name="Cobrar e imprimir ticket"/></Grid>
     </Grid>
    </Grid>
   </Border>
  <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0"><Button Content="Verificar cobro pendiente" Click="CheckoutClick" Visibility="{Binding RecoveryRequired,Converter={StaticResource VisibleWhen}}"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" FontSize="16" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding OperatorLabel}" FontSize="14" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
 </Grid>
</UserControl>
