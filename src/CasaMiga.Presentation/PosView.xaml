<UserControl x:Class="CasaMiga.Presentation.PosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CasaMiga.Presentation" PreviewKeyDown="PosKeyDown" IsVisibleChanged="PosVisibilityChanged">
 <!-- Rediseño A: tarjetas con foto que llenan el ancho y, a la derecha, el ticket con su total y el botón de cobrar. -->
 <Grid IsEnabled="{Binding Ready}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="420"/><ColumnDefinition Width="3*" MinWidth="330"/></Grid.ColumnDefinitions>
  <Grid Margin="0,0,16,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid>
     <TextBox x:Name="SearchInput" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Padding="42,8,12,8" MaxLength="160" AutomationProperties.Name="Buscar producto por nombre o SKU" ToolTip="Buscar nombre o SKU"/>
     <Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="15,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
     <TextBlock Text="Buscar pan o SKU" Margin="44,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button Grid.Column="1" Content="Buscar" Click="SearchClick" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="96"/>
   </Grid>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
    <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Selected}" CommandParameter="{Binding Id}" Style="{StaticResource SectionTabButton}" Click="CategoryClick" Margin="0,0,8,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <ScrollViewer x:Name="ProductCatalogScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
    <ItemsControl ItemsSource="{Binding Products}" IsEnabled="{Binding CanOperate}" Margin="0,0,4,4">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:TileGrid MinItemWidth="146" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource ProductTile}" Tag="{Binding Id}" Click="ProductClick" IsEnabled="{Binding IsActive}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" ClipToBounds="True">
         <Grid>
          <Image Source="{Binding Photo}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasPhoto,Converter={StaticResource VisibleWhen}}"/>
          <Grid Visibility="{Binding IsFallback,Converter={StaticResource VisibleWhen}}">
           <Path Data="M4,5 L16,5 18,8 18,17 2,17 2,8 Z M7,5 L8.5,2 11.5,2 13,5 M10,9 A3,3 0 1 1 9.99,9" Stroke="{DynamicResource WheatBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="44" Height="44" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
           <TextBlock Text="Sin foto" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
          </Grid>
          <!-- Piezas de este pan en el ticket. -->
          <Border Style="{StaticResource CountBadge}" Visibility="{Binding InCart,Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding CartQuantity}" Style="{StaticResource CountBadgeText}"/></Border>
         </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="38" Margin="4,8,4,0" VerticalAlignment="Top"/>
        <TextBlock Grid.Row="2" Text="{Binding Price}" FontSize="15" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Margin="4,2,4,2"/>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <DockPanel Grid.Row="3" Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding Previous}" Style="{StaticResource SecondaryButton}" MinWidth="100" MinHeight="40"/><Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding Next}" Style="{StaticResource SecondaryButton}" MinWidth="100" MinHeight="40" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/></DockPanel>
   <StackPanel Grid.Row="4" Margin="0,8,0,0"><Button Content="Verificar cobro pendiente" Click="CheckoutClick" Visibility="{Binding RecoveryRequired,Converter={StaticResource VisibleWhen}}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding OperatorLabel}" Style="{StaticResource CaptionText}"/></StackPanel>
  </Grid>

  <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="16" Padding="18,16">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <Button DockPanel.Dock="Right" Click="ClearClick" IsEnabled="{Binding CanCheckout}" Style="{StaticResource GhostButton}" MinWidth="0" MinHeight="40" Padding="10,0" VerticalAlignment="Top" AutomationProperties.Name="Limpiar">
      <StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,6,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Limpiar" FontSize="14" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <StackPanel>
      <TextBlock Text="Ticket" Style="{StaticResource SectionTitleText}"/>
      <TextBlock Text="Venta temporal hasta confirmar el cobro" Style="{StaticResource CaptionText}"/>
      <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="{Binding IsDevelopment,Converter={StaticResource VisibleWhen}}"><TextBlock Text="DEMO · precios de prueba" Foreground="{DynamicResource WarningTextBrush}" FontSize="12" FontWeight="SemiBold"/></Border>
     </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource VisibleWhen}}">
      <Viewbox Width="44" Height="44" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconSale}" Stroke="#B4AAA0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
      <TextBlock Text="Carrito vacío" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,2"/>
      <TextBlock Text="Toca un pan para agregarlo." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Lines}" IsEnabled="{Binding CanOperate}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,4,0">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True" VerticalAlignment="Top" Margin="0,0,10,0">
         <Image Source="{Binding Photo}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasPhoto,Converter={StaticResource VisibleWhen}}"/>
        </Border>
        <StackPanel Grid.Column="1">
         <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
         <TextBlock Text="{Binding UnitPrice}" Style="{StaticResource CaptionText}"/>
         <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Border Style="{StaticResource StepperTrack}">
           <StackPanel Orientation="Horizontal">
            <Button Content="−" Tag="{Binding Id}" Click="DecreaseClick" IsEnabled="{Binding CanDecrease}" Style="{StaticResource QuantityButton}" AutomationProperties.Name="Disminuir cantidad"/>
            <TextBlock Text="{Binding Quantity}" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
            <Button Content="+" Tag="{Binding Id}" Click="IncreaseClick" Style="{StaticResource QuantityButton}" AutomationProperties.Name="Incrementar cantidad"/>
           </StackPanel>
          </Border>
          <Button Tag="{Binding Id}" Click="RemoveClick" Style="{StaticResource QuantityButton}" Margin="6,0,0,0" ToolTip="Quitar del ticket" AutomationProperties.Name="Eliminar">
           <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
          </Button>
         </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Total}" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0" VerticalAlignment="Top"/>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
     <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
      <StackPanel>
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal}" Typography.NumeralAlignment="Tabular"/><TextBlock Text="Subtotal" Foreground="{DynamicResource TextSecondaryBrush}"/></DockPanel>
       <DockPanel Margin="0,2,0,12"><TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Style="{StaticResource AmountText}" FontSize="34"/><TextBlock Text="Total" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      </StackPanel>
     </Border>
     <Button Content="{Binding Total}" ContentStringFormat="Cobrar {0}" Click="CheckoutClick" IsEnabled="{Binding CanCheckout}" MinHeight="56" FontSize="18" ToolTip="Confirmar venta sin imprimir ticket" AutomationProperties.Name="Cobrar"/>
     <Button Content="Cobrar + imprimir ticket" Click="CheckoutAndPrintClick" IsEnabled="{Binding CanCheckout}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" AutomationProperties.Name="Cobrar e imprimir ticket"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
