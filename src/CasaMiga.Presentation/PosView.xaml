<UserControl x:Class="CasaMiga.Presentation.PosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="PosKeyDown">
 <Grid Margin="20,12" IsEnabled="{Binding Ready}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8">
   <WrapPanel DockPanel.Dock="Right"><Button Content="Caja" Click="CashClick" Margin="8,0,0,0"/><Button Content="Catálogo" Click="CatalogClick" Margin="8,0,0,0"/><Button Content="Salir de usuario" Click="LogoutClick" Margin="8,0,0,0"/></WrapPanel>
   <StackPanel><TextBlock Text="CASA MIGA · POS" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}"/><TextBlock Text="Identidad visual temporal" FontSize="14"/></StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="DEMO · precios de prueba" Foreground="{DynamicResource BrandBrush}" FontSize="16" Visibility="{Binding IsDevelopment,Converter={StaticResource VisibleWhen}}"/><TextBlock Text="Carrito temporal · No es una venta · Sin cobro" FontSize="16"/></DockPanel>
  <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><TextBlock Text="Buscar nombre o SKU" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Background="Transparent" x:Name="SearchInput" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Buscar producto por nombre o SKU" ToolTip="Buscar nombre o SKU"/></Grid>
   <Button Grid.Column="1" Content="Buscar / actualizar" Click="SearchClick" Margin="8,0,0,0"/>
  </Grid>
  <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
   <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Id}" Click="CategoryClick" Margin="0,0,8,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Productos · pulsa para agregar" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource ProductTile}" Tag="{Binding Product.Id}" Click="ProductClick" AutomationProperties.Name="{Binding Name}"><StackPanel><TextBlock Text="{Binding Name}" FontSize="19" Foreground="White" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding Price}" FontSize="23" Foreground="White" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel DockPanel.Dock="Right"><Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding Previous}" MinWidth="100"/><Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding Next}" MinWidth="100" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding PageLabel}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
   </Grid>
   <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Tu carrito" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid Grid.Row="1"><TextBlock Text="Carrito vacío. Agrega un producto para comenzar." Foreground="{DynamicResource MutedBrush}" Margin="8,16" Visibility="{Binding IsEmpty,Converter={StaticResource VisibleWhen}}"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,2,0,6" Margin="0,0,0,4"><StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
        <DockPanel Margin="0,2,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold"/><TextBlock Text="{Binding UnitPrice}" FontSize="15"/></DockPanel>
        <StackPanel Orientation="Horizontal"><Button Content="−" Tag="{Binding Id}" Click="DecreaseClick" IsEnabled="{Binding CanDecrease}" Style="{StaticResource QuantityButton}" AutomationProperties.Name="Disminuir cantidad"/><TextBlock Text="{Binding Quantity}" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="22"/><Button Content="+" Tag="{Binding Id}" Click="IncreaseClick" Style="{StaticResource QuantityButton}" AutomationProperties.Name="Incrementar cantidad"/><Button Content="Eliminar" Tag="{Binding Id}" Click="RemoveClick" MinWidth="100" Margin="12,0,0,0"/></StackPanel>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </Grid>
     <StackPanel Grid.Row="2" Margin="0,8,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal}"/><TextBlock Text="Subtotal"/></DockPanel><DockPanel Margin="0,6,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontSize="27" FontWeight="Bold"/><TextBlock Text="TOTAL preliminar" FontSize="18" FontWeight="SemiBold"/></DockPanel><Button Content="Limpiar carrito" Click="ClearClick" IsEnabled="{Binding HasLines}"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="5" Margin="0,8,0,0"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" FontSize="16" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding OperatorLabel}" FontSize="14" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
 </Grid>
</UserControl>
