<UserControl x:Class="CasaMiga.Presentation.PosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="PosKeyDown">
 <Grid IsEnabled="{Binding Ready}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="1" Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" Text="DEMO · precios de prueba" Foreground="{DynamicResource BrandBrush}" FontSize="14" Visibility="{Binding IsDevelopment,Converter={StaticResource VisibleWhen}}"/><TextBlock Text="Venta temporal hasta confirmar el cobro" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/></DockPanel>
  <Grid Grid.Row="2" Margin="0,0,0,6" MaxHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><TextBlock Text="Buscar nombre o SKU" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Background="Transparent" x:Name="SearchInput" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Buscar producto por nombre o SKU" ToolTip="Buscar nombre o SKU"/></Grid>
   <Button Grid.Column="1" Content="Buscar" Click="SearchClick" Margin="8,0,0,0" MinWidth="96"/>
  </Grid>
  <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
   <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Selected}" CommandParameter="{Binding Id}" Style="{StaticResource SectionTabButton}" Click="CategoryClick" Margin="0,0,8,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="420"/><ColumnDefinition Width="3*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Productos · pulsa una tarjeta para agregar" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <ScrollViewer x:Name="ProductCatalogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding Products}" IsEnabled="{Binding CanOperate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource ProductTile}" Tag="{Binding Id}" Click="ProductClick" IsEnabled="{Binding IsActive}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="162"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" ClipToBounds="True">
         <Grid>
          <Image Source="{Binding Photo}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasPhoto,Converter={StaticResource VisibleWhen}}"/>
          <Grid Visibility="{Binding IsFallback,Converter={StaticResource VisibleWhen}}">
           <Path Data="M4,5 L16,5 18,8 18,17 2,17 2,8 Z M7,5 L8.5,2 11.5,2 13,5 M10,9 A3,3 0 1 1 9.99,9" Stroke="{DynamicResource WheatBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="48" Height="48" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
           <TextBlock Text="Sin foto" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
          </Grid>
         </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Left" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="2,8,2,1"/>
        <TextBlock Grid.Row="2" Text="{Binding Price}" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" TextAlignment="Left" Margin="2,4,2,0"/>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel DockPanel.Dock="Right"><Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding Previous}" MinWidth="100"/><Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding Next}" MinWidth="100" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding PageLabel}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
   </Grid>
   <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AvocadoLeafBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Tu carrito" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid Grid.Row="1"><TextBlock Text="Carrito vacío. Agrega un producto para comenzar." Foreground="{DynamicResource MutedBrush}" Margin="8,16" Visibility="{Binding IsEmpty,Converter={StaticResource VisibleWhen}}"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Lines}" IsEnabled="{Binding CanOperate}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,2,0,6" Margin="0,0,0,4"><StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
        <DockPanel Margin="0,2,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold"/><TextBlock Text="{Binding UnitPrice}" FontSize="15"/></DockPanel>
        <StackPanel Orientation="Horizontal"><Button Content="−" Tag="{Binding Id}" Click="DecreaseClick" IsEnabled="{Binding CanDecrease}" Style="{StaticResource QuantityButton}" AutomationProperties.Name="Disminuir cantidad"/><TextBlock Text="{Binding Quantity}" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="22"/><Button Content="+" Tag="{Binding Id}" Click="IncreaseClick" Style="{StaticResource QuantityButton}" AutomationProperties.Name="Incrementar cantidad"/><Button Content="Eliminar" Tag="{Binding Id}" Click="RemoveClick" MinWidth="100" Margin="12,0,0,0"/></StackPanel>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </Grid>
     <StackPanel Grid.Row="2" Margin="0,8,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal}"/><TextBlock Text="Subtotal"/></DockPanel><DockPanel Margin="0,6,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontSize="27" FontWeight="Bold"/><TextBlock Text="TOTAL preliminar" FontSize="18" FontWeight="SemiBold"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Limpiar" Click="ClearClick" IsEnabled="{Binding CanCheckout}"/><Button Grid.Column="2" Content="Cobrar" Click="CheckoutClick" IsEnabled="{Binding CanCheckout}"/></Grid></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="5" Margin="0,8,0,0"><Button Content="Verificar cobro pendiente" Click="CheckoutClick" Visibility="{Binding RecoveryRequired,Converter={StaticResource VisibleWhen}}"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" FontSize="16" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding OperatorLabel}" FontSize="14" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
 </Grid>
</UserControl>
