<UserControl x:Class="CasaMiga.Presentation.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel IsEnabled="{Binding Ready}">
  <TextBlock Text="Periodo · días locales en formato AAAA-MM-DD" FontSize="16"/>
  <Grid Margin="0,4,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="FromBox" Text="{Binding FromDate,UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Fecha desde" Margin="0,0,8,0"/>
   <TextBox Grid.Column="1" Text="{Binding ThroughDate,UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Fecha hasta" Margin="8,0"/>
   <Button Grid.Column="2" Content="Generar" Click="GenerateClick" Margin="8,0"/>
   <Button Grid.Column="3" Content="Hoy" Click="TodayClick" Style="{StaticResource SecondaryButton}" Margin="8,0"/>
   <Button Grid.Column="4" Content="Este mes" Click="MonthClick" Style="{StaticResource SecondaryButton}" Margin="8,0"/>
   <Button Grid.Column="5" Content="Exportar CSV" Click="ExportClick" IsEnabled="{Binding HasReport}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" AutomationProperties.Name="Exportar reporte a CSV"/>
  </Grid>
  <StackPanel Visibility="{Binding HasReport,Converter={StaticResource VisibleWhen}}">
   <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Stretch" Margin="0,0,0,16"><TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
   <TextBlock Text="Por producto" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6"/>
   <DataGrid ItemsSource="{Binding Products}" Height="220" IsReadOnly="True" AutoGenerateColumns="False" AutomationProperties.Name="Ventas por producto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="180"/>
     <DataGridTextColumn Header="Piezas vendidas" Binding="{Binding Sold}" Width="130"/>
     <DataGridTextColumn Header="Vendido" Binding="{Binding SoldAmount}" Width="120"/>
     <DataGridTextColumn Header="Piezas devueltas" Binding="{Binding Refunded}" Width="140"/>
     <DataGridTextColumn Header="Devuelto" Binding="{Binding RefundedAmount}" Width="120"/>
     <DataGridTextColumn Header="Neto" Binding="{Binding Net}" Width="120"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Por forma de pago" Style="{StaticResource SectionTitleText}" Margin="0,16,0,6"/>
   <DataGrid ItemsSource="{Binding Payments}" Height="120" IsReadOnly="True" AutoGenerateColumns="False" AutomationProperties.Name="Ventas por forma de pago">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Forma de pago" Binding="{Binding Method}" Width="*"/>
     <DataGridTextColumn Header="Ventas" Binding="{Binding Sales}" Width="100"/>
     <DataGridTextColumn Header="Vendido" Binding="{Binding Sold}" Width="130"/>
     <DataGridTextColumn Header="Devuelto" Binding="{Binding Refunded}" Width="130"/>
     <DataGridTextColumn Header="Neto" Binding="{Binding Net}" Width="130"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Por cajero" Style="{StaticResource SectionTitleText}" Margin="0,16,0,6"/>
   <DataGrid ItemsSource="{Binding Cashiers}" Height="140" IsReadOnly="True" AutoGenerateColumns="False" AutomationProperties.Name="Ventas por cajero">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Cajero" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="Ventas" Binding="{Binding Sales}" Width="100"/>
     <DataGridTextColumn Header="Vendido" Binding="{Binding Sold}" Width="140"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="Cortes de caja (turnos abiertos en el periodo)" Style="{StaticResource SectionTitleText}" Margin="0,16,0,6"/>
   <DataGrid ItemsSource="{Binding Sessions}" Height="180" IsReadOnly="True" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Cortes de caja">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Apertura" Binding="{Binding Opened}" Width="130"/>
     <DataGridTextColumn Header="Cierre" Binding="{Binding Closed}" Width="130"/>
     <DataGridTextColumn Header="Abrió" Binding="{Binding OpenedBy}" Width="140"/>
     <DataGridTextColumn Header="Fondo" Binding="{Binding Opening}" Width="100"/>
     <DataGridTextColumn Header="Ventas efectivo" Binding="{Binding CashSales}" Width="130"/>
     <DataGridTextColumn Header="Devoluciones" Binding="{Binding Refunds}" Width="120"/>
     <DataGridTextColumn Header="Esperado" Binding="{Binding Expected}" Width="110"/>
     <DataGridTextColumn Header="Contado" Binding="{Binding Counted}" Width="110"/>
     <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference}" Width="150"/>
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0"/>
 </StackPanel>
</UserControl>
