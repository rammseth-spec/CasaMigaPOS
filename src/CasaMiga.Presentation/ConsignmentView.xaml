<UserControl x:Class="CasaMiga.Presentation.ConsignmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CasaMiga.Presentation">
 <UserControl.Resources>
  <Style x:Key="Kpi" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
  <Style x:Key="KpiLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="KpiValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleText}"><Setter Property="Margin" Value="0,18,0,8"/></Style>
  <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource SectionTabButton}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="14,6"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,8,8,0"/></Style>
  <!-- Piezas: sin escribir números; se suman o restan con los botones (o tocando la tarjeta). -->
  <Style x:Key="Step" TargetType="Button" BasedOn="{StaticResource QuantityButton}"/>
  <Style x:Key="CountLabel" TargetType="TextBlock"><Setter Property="MinWidth" Value="30"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18,16"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="HeaderCell" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <DataTemplate x:Key="HBarTemplate">
   <Grid Margin="0,5" ToolTip="{Binding Tip}" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="BarLabel"/><ColumnDefinition Width="*" MinWidth="60"/><ColumnDefinition Width="Auto" SharedSizeGroup="BarValue"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Label}" FontSize="15" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,0,12,0"/>
    <Grid Grid.Column="1" Height="12" VerticalAlignment="Center">
     <Border CornerRadius="6" Background="{DynamicResource ChartTrackBrush}"/>
     <Border CornerRadius="6" Background="{DynamicResource ChartBrush}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding Ratio}"/></Border.RenderTransform></Border>
    </Grid>
    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="12,0,0,0"/>
   </Grid>
  </DataTemplate>
  <!-- Fila de charola habitual: pan, precio de charola y piezas con − y + (sin escribir el número).
       Las listas dentro de un ScrollViewer se enlazan vía la pantalla: si la vista nace sin datos y oculta, un enlace directo queda en PathError. -->
  <DataTemplate x:Key="TrayLineTemplate">
   <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
     <TextBlock Grid.Column="1" Text="{Binding Price}" Style="{StaticResource Note}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
     <Border Grid.Column="2" Style="{StaticResource StepperTrack}">
      <StackPanel Orientation="Horizontal">
       <Button Content="−" Style="{StaticResource Step}" Click="TrayMinusClick" AutomationProperties.Name="{Binding Name,StringFormat='Quitar una pieza de {0}'}"/>
       <TextBlock Text="{Binding Quantity}" Style="{StaticResource CountLabel}" AutomationProperties.Name="{Binding Name,StringFormat='Piezas de {0}'}"/>
       <Button Content="+" Style="{StaticResource Step}" Click="TrayPlusClick" AutomationProperties.Name="{Binding Name,StringFormat='Agregar una pieza de {0}'}"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </DataTemplate>
  <!-- Tarjeta de pan como en el Punto de venta: tocar suma una pieza; la burbuja verde muestra las piezas en la charola. -->
  <Style x:Key="TrayTile" TargetType="Button" BasedOn="{StaticResource ProductTile}"><Setter Property="Height" Value="222"/><Setter Property="Padding" Value="8"/>
   <Style.Triggers><DataTrigger Binding="{Binding HasPieces}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate x:Key="TrayTileTemplate">
   <Button Style="{StaticResource TrayTile}" Click="TileClick" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name,StringFormat='Agregar {0} a la charola'}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" ClipToBounds="True">
      <Grid>
       <Image Source="{Binding Photo}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasPhoto,Converter={StaticResource VisibleWhen}}"/>
       <Path Data="M4,5 L16,5 18,8 18,17 2,17 2,8 Z M7,5 L8.5,2 11.5,2 13,5 M10,9 A3,3 0 1 1 9.99,9" Stroke="{DynamicResource WheatBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="44" Height="44" Visibility="{Binding IsFallback,Converter={StaticResource VisibleWhen}}"/>
       <Border Style="{StaticResource CountBadge}" Visibility="{Binding HasPieces,Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding Quantity}" Style="{StaticResource CountBadgeText}"/></Border>
      </Grid>
     </Border>
     <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="38" Margin="4,8,4,0" VerticalAlignment="Top"/>
     <TextBlock Grid.Row="2" Text="{Binding Price}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Typography.NumeralAlignment="Tabular" Margin="4,2,4,2"/>
    </Grid>
   </Button>
  </DataTemplate>
  <!-- Tarjeta para recoger: tocarla suma una pieza que regresó (burbuja y orilla trigo). Sin escribir números; «−» corrige. -->
  <DataTemplate x:Key="CollectCardTemplate">
   <Grid>
    <Button Click="ReturnTileClick" Padding="10" MinWidth="0" MinHeight="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Normal" FontSize="15" ToolTip="Toca una vez por cada pieza que regresó" AutomationProperties.Name="{Binding Name,StringFormat='Regresó una pieza de {0}'}">
     <Button.Template><ControlTemplate TargetType="Button">
      <Grid>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="16"/>
       <Border x:Name="Hover" Background="{DynamicResource TextPrimaryBrush}" Opacity="0" CornerRadius="16" IsHitTestVisible="False"/>
       <Border x:Name="Ring" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="2" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False"/>
       <ContentPresenter Margin="{TemplateBinding Padding}"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.03"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/></Trigger>
       <DataTrigger Binding="{Binding HasReturns}" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></DataTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="96" Height="96" CornerRadius="12" Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True" VerticalAlignment="Top">
       <Grid>
        <Image Source="{Binding Photo}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasPhoto,Converter={StaticResource VisibleWhen}}"/>
        <Path Data="M4,5 L16,5 18,8 18,17 2,17 2,8 Z M7,5 L8.5,2 11.5,2 13,5 M10,9 A3,3 0 1 1 9.99,9" Stroke="{DynamicResource WheatBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="36" Height="36" Visibility="{Binding IsFallback,Converter={StaticResource VisibleWhen}}"/>
        <Border Style="{StaticResource CountBadge}" Background="{DynamicResource WarningBrush}" Visibility="{Binding HasReturns,Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding Returned}" Style="{StaticResource CountBadgeText}"/></Border>
       </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,44,0">
       <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
       <TextBlock Text="{Binding DeliveredText}" Style="{StaticResource Note}" Margin="0,2,0,0"/>
       <TextBlock Text="{Binding ReturnedLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" Margin="0,2,0,0" Visibility="{Binding HasReturns,Converter={StaticResource VisibleWhen}}"/>
       <TextBlock Text="{Binding SoldText}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,6,0,0"/>
      </StackPanel>
     </Grid>
    </Button>
    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconMinus}" Click="ReturnMinusClick" Background="{DynamicResource SurfaceSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Width="40" Height="40" MinWidth="40" MinHeight="40" ToolTip="Una pieza menos" Visibility="{Binding HasReturns,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding Name,StringFormat='Una pieza menos regresó de {0}'}"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <StackPanel IsEnabled="{Binding Ready}">
  <WrapPanel Margin="0,0,0,8" Visibility="{Binding ShowTabs,Converter={StaticResource VisibleWhen}}">
   <Button Content="Ruta del día" Style="{StaticResource Tab}" Tag="{Binding IsRoute}" Click="RouteClick"/>
   <Button Content="Tiendas" Style="{StaticResource Tab}" Tag="{Binding IsStores}" Click="StoresClick"/>
   <Button Content="Precios de charola" Style="{StaticResource Tab}" Tag="{Binding IsPrices}" Click="PricesClick"/>
   <Button Content="Reporte" Style="{StaticResource Tab}" Tag="{Binding IsReport}" Click="ReportClick"/>
  </WrapPanel>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ValidBrush}"/></DataTrigger><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>

  <!-- ===== Entregar: tarjetas y filtros como en el Punto de venta; la charola a la derecha como el carrito ===== -->
  <Grid x:Name="DeliverWorkspace" MinHeight="460" Visibility="{Binding IsDeliverWorkspace,Converter={StaticResource VisibleWhen}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="420"/><ColumnDefinition Width="3*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <Button DockPanel.Dock="Right" Content="Volver a la ruta" Click="CancelClick" Style="{StaticResource SecondaryButton}" MinWidth="0" MinHeight="38" Padding="14,6" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,8">
     <TextBox x:Name="DeliverSearchBox" Text="{Binding DeliverSearch,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Buscar pan o SKU"/>
     <TextBlock Text="Buscar pan o SKU" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=DeliverSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
     <ItemsControl ItemsSource="{Binding DataContext.DeliverCategories,RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False" AutomationProperties.Name="Categorías">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Selected}" Style="{StaticResource SectionTabButton}" Click="CategoryClick" Margin="0,0,8,4"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
     <ItemsControl ItemsSource="{Binding DataContext.DeliverTiles,RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource TrayTileTemplate}" Focusable="False" Margin="0,0,4,4" AutomationProperties.Name="Panes para la charola">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:TileGrid MinItemWidth="140" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="Ningún pan con precio de charola coincide con la búsqueda." Style="{StaticResource Note}" FontSize="15" VerticalAlignment="Top" Margin="0,12,0,0" Visibility="{Binding NoTiles,Converter={StaticResource VisibleWhen}}"/>
   </Grid>
   <Border Grid.Column="1" Style="{StaticResource Panel}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Charola" FontSize="24" FontWeight="SemiBold"/>
     <WrapPanel Grid.Row="1" Margin="0,0,0,6">
      <Button Content="Charola habitual" Style="{StaticResource Chip}" Click="UseTemplateClick" Visibility="{Binding HasTemplate,Converter={StaticResource VisibleWhen}}"/>
      <Button Content="Vaciar" Style="{StaticResource Chip}" Click="ClearTrayClick"/>
     </WrapPanel>
     <Grid Grid.Row="2">
      <TextBlock Text="Toca los panes para agregarlos a la charola." Style="{StaticResource Note}" FontSize="15" Margin="4,12" Visibility="{Binding TrayIsEmpty,Converter={StaticResource VisibleWhen}}"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl ItemsSource="{Binding DataContext.TrayLines,RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False" AutomationProperties.Name="Piezas de la charola">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,8" Margin="0,0,6,4">
          <StackPanel>
           <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           <DockPanel Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
             <TextBlock Text="{Binding LineAmount}" FontSize="15" FontWeight="Bold" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
             <TextBlock Text="{Binding Price,StringFormat='{}{0} c/u'}" Style="{StaticResource Note}" TextAlignment="Right"/>
            </StackPanel>
            <Border Style="{StaticResource StepperTrack}">
             <StackPanel Orientation="Horizontal">
              <Button Content="−" Style="{StaticResource Step}" Click="TrayMinusClick" AutomationProperties.Name="{Binding Name,StringFormat='Quitar una pieza de {0}'}"/>
              <TextBlock Text="{Binding Quantity}" Style="{StaticResource CountLabel}" AutomationProperties.Name="{Binding Name,StringFormat='Piezas de {0}'}"/>
              <Button Content="+" Style="{StaticResource Step}" Click="TrayPlusClick" AutomationProperties.Name="{Binding Name,StringFormat='Agregar una pieza de {0}'}"/>
             </StackPanel>
            </Border>
           </DockPanel>
          </StackPanel>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </Grid>
     <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DeliverPiecesText}" FontWeight="SemiBold"/><TextBlock Text="Piezas"/></DockPanel>
      <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding DeliverValue}" FontSize="26" FontWeight="Bold"/><TextBlock Text="Precio de charola" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="{Binding DeliverRetail}" Style="{StaticResource Note}" TextAlignment="Right"/>
      <Grid Margin="0,8,0,8">
       <TextBox x:Name="DeliverNoteBox" Text="{Binding DeliverNote,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Nota de la entrega"/>
       <TextBlock Text="Nota (opcional)" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=DeliverNoteBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Button Content="Confirmar entrega" Click="ConfirmDeliverClick" IsEnabled="{Binding CanDeliver}"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>

  <!-- ===== Recoger: una tarjeta por pan dejado; el cobro a la derecha ===== -->
  <Grid x:Name="CollectWorkspace" MinHeight="460" Visibility="{Binding IsCollectWorkspace,Converter={StaticResource VisibleWhen}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="420"/><ColumnDefinition Width="3*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,4">
     <Button DockPanel.Dock="Right" Content="Volver a la ruta" Click="CancelClick" Style="{StaticResource SecondaryButton}" MinWidth="0" MinHeight="38" Padding="14,6" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding CollectHint}" Style="{StaticResource Note}" FontSize="14" Margin="0,0,0,10"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
     <ItemsControl ItemsSource="{Binding DataContext.CollectLines,RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource CollectCardTemplate}" Focusable="False" Margin="0,0,4,4" AutomationProperties.Name="Piezas que regresaron">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:TileGrid MinItemWidth="250" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <Border Grid.Column="1" Style="{StaticResource Panel}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding CollectPanelTitle}" FontSize="24" FontWeight="SemiBold"/>
     <ScrollViewer x:Name="CollectPanelScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
      <StackPanel Margin="0,8,0,0">
       <StackPanel Visibility="{Binding IsChargeOpen,Converter={StaticResource VisibleWhen}}">
        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CollectSoldText}" FontWeight="SemiBold"/><TextBlock Text="Vendidas"/></DockPanel>
        <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding CollectReturnedText}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="Regresan para Piedra"/></DockPanel>
        <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding CollectAmountText}" FontWeight="SemiBold"/><TextBlock Text="Importe de la charola"/></DockPanel>
        <DockPanel Margin="0,4,0,0" Visibility="{Binding HasPreviousBalance,Converter={StaticResource VisibleWhen}}"><TextBlock DockPanel.Dock="Right" Text="{Binding PreviousBalanceText}" FontWeight="SemiBold"/><TextBlock Text="Saldo anterior"/></DockPanel>
        <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding TotalOwedText}" FontSize="26" FontWeight="Bold"/><TextBlock Text="Total a pagar" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <Grid Margin="0,12,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="Cobrado ahora" VerticalAlignment="Center" Margin="0,0,12,8"/>
         <TextBox Grid.Column="1" Text="{Binding PaidText,UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,0,0,8" AutomationProperties.Name="Importe cobrado ahora" ToolTip="Si la tienda paga después, deja 0 y queda a cuenta."/>
         <TextBlock Grid.Row="1" Text="Forma de pago" VerticalAlignment="Center" Margin="0,0,12,8"/>
         <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Methods}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedMethod}" SelectionChanged="MethodChanged" Margin="0,0,0,8" AutomationProperties.Name="Forma de pago"/>
         <TextBlock Grid.Row="2" Text="Referencia" VerticalAlignment="Center" Margin="0,0,12,8" Visibility="{Binding NeedsReference,Converter={StaticResource VisibleWhen}}"/>
         <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Reference,UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,0,0,8" AutomationProperties.Name="Referencia del pago" Visibility="{Binding NeedsReference,Converter={StaticResource VisibleWhen}}"/>
        </Grid>
        <Grid>
         <TextBox x:Name="CollectNoteBox" Text="{Binding CollectNote,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Nota de la recolección"/>
         <TextBlock Text="Nota (opcional)" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=CollectNoteBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
        <TextBlock Text="Si la tienda paga después, deja 0 y queda a cuenta." Style="{StaticResource Note}" Margin="0,6,0,0"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsVoidOpen,Converter={StaticResource VisibleWhen}}">
        <TextBlock Text="¿Se capturó mal la entrega? Al anularla no se cobra ni cuenta en los reportes." Style="{StaticResource Note}" FontSize="14"/>
        <TextBlock Text="Motivo" Margin="0,14,0,6"/>
        <Grid>
         <TextBox x:Name="VoidReasonBox" Text="{Binding VoidReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Motivo para anular la charola"/>
         <TextBlock Text="Ej.: era otra tienda" Margin="14,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=VoidReasonBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <StackPanel Visibility="{Binding IsChargeOpen,Converter={StaticResource VisibleWhen}}">
       <Button Content="Confirmar recolección" Click="ConfirmCollectClick"/>
       <Button Content="Anular esta charola…" Click="OpenVoidClick" Style="{StaticResource GhostButton}" Foreground="{DynamicResource ErrorBrush}" FontSize="14" MinHeight="32" MinWidth="0" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsVoidOpen,Converter={StaticResource VisibleWhen}}">
       <Button Content="Anular charola" Click="VoidClick" Style="{StaticResource DestructiveButton}"/>
       <Button Content="Cancelar y volver al cobro" Click="CloseVoidClick" Style="{StaticResource GhostButton}" FontSize="14" MinHeight="32" MinWidth="0" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>

  <!-- ===== Ruta del día ===== -->
  <Grid Visibility="{Binding IsRouteBoard,Converter={StaticResource VisibleWhen}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="4*" MinWidth="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="8*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Note}" Margin="0,0,0,8"/>
    <TextBlock Text="Agrega tus tiendas en la pestaña «Tiendas» y el precio de cada pan en «Precios de charola»." Style="{StaticResource EmptyStateText}" Visibility="{Binding NoStores,Converter={StaticResource VisibleWhen}}"/>
    <ItemsControl ItemsSource="{Binding Route}" Focusable="False" AutomationProperties.Name="Tiendas de la ruta">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <DockPanel>
         <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Top">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource ChartTrackBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Owes}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <TextBlock Text="{Binding Balance}" FontSize="13" FontWeight="SemiBold"/>
         </Border>
         <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/>
        </DockPanel>
        <TextBlock Text="{Binding Contact}" Style="{StaticResource Note}" Visibility="{Binding HasContact,Converter={StaticResource VisibleWhen}}"/>
        <TextBlock Text="{Binding TrayText}" FontSize="14" Margin="0,4,0,0"/>
        <WrapPanel>
         <Button Content="Entregar" Style="{StaticResource Chip}" Click="DeliverClick" IsEnabled="{Binding DataContext.CanManage,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding Name,StringFormat='Entregar charola a {0}'}"/>
         <Button Content="Recoger" Style="{StaticResource Chip}" Click="CollectClick" Visibility="{Binding HasTray,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding DataContext.CanManage,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding Name,StringFormat='Recoger charola de {0}'}"/>
         <Button Content="Cobrar" Style="{StaticResource Chip}" Click="PayClick" Visibility="{Binding Owes,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding DataContext.CanManage,RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding Name,StringFormat='Cobrar a {0}'}"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>

   <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20,16">
    <StackPanel>
     <StackPanel Visibility="{Binding NoAction,Converter={StaticResource VisibleWhen}}">
      <TextBlock Text="¿Cómo funciona?" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
      <TextBlock Style="{StaticResource Note}" FontSize="15" LineHeight="24">
       <Run Text="1. Entregar: deja la charola con su charola habitual o ajusta las piezas."/><LineBreak/>
       <Run Text="2. Recoger: al día siguiente captura cuántas piezas regresaron. Lo demás se vendió y se carga a la tienda."/><LineBreak/>
       <Run Text="3. Lo que regresa se aparta para hacer Piedra."/><LineBreak/>
       <Run Text="4. Cobrar: registra pagos de la tienda. No entra a la caja del mostrador."/>
      </TextBlock>
     </StackPanel>
     <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding HasAction,Converter={StaticResource VisibleWhen}}"/>

     <!-- Cobrar -->
     <StackPanel Visibility="{Binding IsPaying,Converter={StaticResource VisibleWhen}}">
      <TextBlock Text="{Binding Selected.Balance}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,12"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Importe"/><TextBox Text="{Binding PayAmountText,UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,6,0,12" AutomationProperties.Name="Importe del cobro"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Forma de pago"/><ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedMethod}" SelectionChanged="MethodChanged" Margin="0,6,0,12" AutomationProperties.Name="Forma de pago del cobro"/></StackPanel>
      </Grid>
      <StackPanel Visibility="{Binding NeedsReference,Converter={StaticResource VisibleWhen}}"><TextBlock Text="Referencia (opcional)"/><TextBox Text="{Binding Reference,UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,6,0,12"/></StackPanel>
      <TextBlock Text="Nota (opcional)"/>
      <TextBox Text="{Binding PayNote,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,6,0,12" AutomationProperties.Name="Nota del cobro"/>
      <WrapPanel>
       <Button Content="Registrar cobro" Click="ConfirmPayClick" Margin="0,0,12,8"/>
       <Button Content="Cancelar" Click="CancelClick" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
      </WrapPanel>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>

  <!-- ===== Tiendas ===== -->
  <Grid Visibility="{Binding IsStores,Converter={StaticResource VisibleWhen}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="4*" MinWidth="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <Button Content="Nueva tienda" Click="NewStoreClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" IsEnabled="{Binding CanManage}"/>
    <ListBox ItemsSource="{Binding Stores}" SelectionChanged="StoreSelected" MaxHeight="560" AutomationProperties.Name="Tiendas">
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel Margin="4,6">
       <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Style="{StaticResource Note}"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1}"><Binding Path="Contact"/><Binding Path="Phone"/></MultiBinding></TextBlock.Text></TextBlock>
       <TextBlock Text="Desactivada" Foreground="{DynamicResource ErrorBrush}" FontSize="13">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Active}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel>
   <StackPanel Grid.Column="2" IsEnabled="{Binding CanManage}">
    <Border Style="{StaticResource Card}" Padding="20,16">
     <StackPanel>
      <TextBlock Text="{Binding StoreFormTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
      <TextBlock Text="Nombre de la tienda"/><TextBox Text="{Binding StoreName,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,6,0,12" AutomationProperties.Name="Nombre de la tienda"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Contacto"/><TextBox Text="{Binding StoreContact,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,6,0,12" AutomationProperties.Name="Contacto"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Teléfono"/><TextBox Text="{Binding StorePhone,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,6,0,12" AutomationProperties.Name="Teléfono"/></StackPanel>
      </Grid>
      <TextBlock Text="Dirección"/><TextBox Text="{Binding StoreAddress,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,6,0,12" AutomationProperties.Name="Dirección"/>
      <WrapPanel>
       <Button Content="Guardar tienda" Click="SaveStoreClick" Margin="0,0,12,8"/>
       <Button Content="{Binding ToggleStoreText}" Click="ToggleStoreClick" Style="{StaticResource SecondaryButton}" Visibility="{Binding IsExistingStore,Converter={StaticResource VisibleWhen}}" Margin="0,0,0,8"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Padding="20,16" Visibility="{Binding IsExistingStore,Converter={StaticResource VisibleWhen}}">
     <StackPanel>
      <DockPanel Margin="0,0,0,6">
       <TextBlock DockPanel.Dock="Right" Text="{Binding TemplateSummary}" Style="{StaticResource Note}" VerticalAlignment="Center"/>
       <TextBlock Text="Charola habitual" Style="{StaticResource SectionTitleText}"/>
      </DockPanel>
      <TextBlock Text="Se propone al entregar; siempre puedes ajustar las piezas ese día." Style="{StaticResource Note}" Margin="0,0,0,8"/>
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl ItemsSource="{Binding DataContext.TemplateLines,RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource TrayLineTemplate}" Focusable="False" Margin="0,0,8,0" AutomationProperties.Name="Charola habitual"/>
      </ScrollViewer>
      <Button Content="Guardar charola habitual" Click="SaveTemplateClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Padding="20,16" Visibility="{Binding IsExistingStore,Converter={StaticResource VisibleWhen}}">
     <StackPanel>
      <DockPanel Margin="0,0,0,8">
       <TextBlock DockPanel.Dock="Right" Text="{Binding AccountBalance}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
       <TextBlock Text="Estado de cuenta" Style="{StaticResource SectionTitleText}"/>
      </DockPanel>
      <TextBlock Text="Sin movimientos todavía.">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Note}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMovements}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <DataGrid ItemsSource="{Binding Movements}" MaxHeight="300" Visibility="{Binding HasMovements,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Movimientos de la tienda">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="Auto" MinWidth="100"/>
        <DataGridTextColumn Header="Concepto" Binding="{Binding Concept}" Width="*" MinWidth="200"/>
        <DataGridTextColumn Header="Cargo" Binding="{Binding Charge}" Width="Auto" MinWidth="96" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
        <DataGridTextColumn Header="Pago" Binding="{Binding Payment}" Width="Auto" MinWidth="96" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>

  <!-- ===== Precios de charola ===== -->
  <StackPanel Visibility="{Binding IsPrices,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding CanManage}">
   <TextBlock Text="Lo que paga la tienda por cada pieza vendida, igual para todas las tiendas. Un pan sin precio no se puede poner en charolas." Style="{StaticResource Note}" FontSize="14" Margin="0,0,0,10"/>
   <Border Style="{StaticResource Card}" Padding="16,10">
    <StackPanel>
     <Grid Margin="0,0,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <TextBlock Text="Pan" Style="{StaticResource HeaderCell}"/>
      <TextBlock Grid.Column="1" Text="Categoría" Style="{StaticResource HeaderCell}"/>
      <TextBlock Grid.Column="2" Text="Mostrador" Style="{StaticResource HeaderCell}" TextAlignment="Right" Margin="0,0,12,0"/>
      <TextBlock Grid.Column="3" Text="Charola" Style="{StaticResource HeaderCell}"/>
      <TextBlock Grid.Column="4" Text="Diferencia" Style="{StaticResource HeaderCell}"/>
     </Grid>
     <ItemsControl ItemsSource="{Binding Prices}" Focusable="False" AutomationProperties.Name="Precios de charola">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Grid Margin="0,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Note}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Retail}" FontSize="15" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
        <TextBox Grid.Column="3" Text="{Binding PriceText,UpdateSourceTrigger=PropertyChanged}" MaxLength="10" MinHeight="38" FontSize="16" Padding="8,4" Margin="0,0,12,0" AutomationProperties.Name="{Binding Name,StringFormat='Precio de charola de {0}'}"/>
        <TextBlock Grid.Column="4" Text="{Binding Difference}" Style="{StaticResource Note}" VerticalAlignment="Center"/>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>
   <Button Content="Guardar precios" Click="SavePricesClick" HorizontalAlignment="Left"/>
  </StackPanel>

  <!-- ===== Reporte ===== -->
  <StackPanel Visibility="{Binding IsReport,Converter={StaticResource VisibleWhen}}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Desde" Style="{StaticResource KpiLabel}"/><DatePicker SelectedDate="{Binding FromSelected}" Width="200" Margin="0,4,0,0" AutomationProperties.Name="Fecha desde"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Hasta" Style="{StaticResource KpiLabel}"/><DatePicker SelectedDate="{Binding ThroughSelected}" Width="200" Margin="0,4,0,0" AutomationProperties.Name="Fecha hasta"/></StackPanel>
    <Button Grid.Column="2" Content="Generar" Click="GenerateClick" VerticalAlignment="Bottom" MinWidth="120"/>
    <TextBlock Grid.Column="3" Text="{Binding GeneratedLabel}" Style="{StaticResource KpiLabel}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="12,0,0,14"/>
   </Grid>
   <WrapPanel Margin="0,4,0,8">
    <Button Content="Hoy" Click="TodayClick" Style="{StaticResource Chip}"/>
    <Button Content="Últimos 7 días" Click="LastSevenDaysClick" Style="{StaticResource Chip}"/>
    <Button Content="Este mes" Click="MonthClick" Style="{StaticResource Chip}"/>
   </WrapPanel>
   <TextBlock Text="Sin charolas entregadas en este periodo." Style="{StaticResource EmptyStateText}" Visibility="{Binding NoReportRows,Converter={StaticResource VisibleWhen}}"/>
   <StackPanel Visibility="{Binding HasReportRows,Converter={StaticResource VisibleWhen}}">
    <UniformGrid Columns="4" Margin="0,4,-12,0">
     <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="Charolas entregadas" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportTrays}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
     <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="Piezas entregadas" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportDelivered}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
     <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="Vendidas · % de venta" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportSold}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
     <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="Regresaron para Piedra" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportReturned}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
     <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="Cargado a tiendas" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportCharged}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
     <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="Pagos recibidos" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportPaid}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
     <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="Por cobrar hoy" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportBalance}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
     <Border Style="{StaticResource Kpi}" ToolTip="Precio de mostrador menos precio de charola de las piezas vendidas en tiendas."><StackPanel><TextBlock Text="Margen que se queda en tiendas" Style="{StaticResource KpiLabel}"/><TextBlock Text="{Binding ReportLeft}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
    </UniformGrid>
    <TextBlock Text="{Binding ReportAtStore}" Style="{StaticResource Note}" FontSize="14" Margin="0,0,0,8"/>
    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,4,0,8">
     <StackPanel>
      <TextBlock Text="% de venta por tienda" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="De las charolas ya recogidas: piezas vendidas entre piezas dejadas." Style="{StaticResource KpiLabel}" Margin="0,2,0,8"/>
      <ItemsControl ItemsSource="{Binding SellThroughBars}" ItemTemplate="{StaticResource HBarTemplate}" Grid.IsSharedSizeScope="True" Focusable="False" AutomationProperties.Name="Porcentaje de venta por tienda"/>
     </StackPanel>
    </Border>
    <TextBlock Text="Por tienda" Style="{StaticResource Section}"/>
    <DataGrid ItemsSource="{Binding StoreRows}" MaxHeight="420" AutomationProperties.Name="Charolas por tienda">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Tienda" Binding="{Binding Name}" Width="*" MinWidth="150"/>
      <DataGridTextColumn Header="Charolas" Binding="{Binding Trays}" Width="Auto" MinWidth="86" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Dejadas" Binding="{Binding Delivered}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Vendidas" Binding="{Binding Sold}" Width="Auto" MinWidth="86" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Piedra" Binding="{Binding Returned}" Width="Auto" MinWidth="72" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="% venta" Binding="{Binding SellThrough}" Width="Auto" MinWidth="84" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Cargo" Binding="{Binding Charged}" Width="Auto" MinWidth="96" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Pagado" Binding="{Binding Paid}" Width="Auto" MinWidth="96" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Debe" Binding="{Binding Balance}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="Por pan" Style="{StaticResource Section}"/>
    <DataGrid ItemsSource="{Binding ProductRows}" MaxHeight="460" AutomationProperties.Name="Charolas por pan">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Pan" Binding="{Binding Name}" Width="*" MinWidth="200"/>
      <DataGridTextColumn Header="Dejadas" Binding="{Binding Delivered}" Width="Auto" MinWidth="86" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Vendidas" Binding="{Binding Sold}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Regresaron (Piedra)" Binding="{Binding Returned}" Width="Auto" MinWidth="150" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="% venta" Binding="{Binding SellThrough}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
      <DataGridTextColumn Header="Cargo" Binding="{Binding Charged}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}"/>
     </DataGrid.Columns>
    </DataGrid>
   </StackPanel>
  </StackPanel>
 </StackPanel>
</UserControl>
