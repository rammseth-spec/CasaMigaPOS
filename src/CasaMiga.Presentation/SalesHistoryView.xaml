<UserControl x:Class="CasaMiga.Presentation.SalesHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="HistoryKeyDown">
 <StackPanel IsEnabled="{Binding Ready}">
  <StackPanel Visibility="{Binding IsList,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Buscar por folio exacto" FontSize="16"/>
   <Grid Margin="0,4,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="FolioBox" Text="{Binding Folio,UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Folio exacto"/>
    <Button Grid.Column="1" Content="Buscar folio" Click="SearchFolioClick" Margin="12,0,0,0"/>
   </Grid>
   <TextBlock Text="O buscar por días locales · formato AAAA-MM-DD" FontSize="16"/>
   <Grid Margin="0,4,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding FromDate,UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Fecha desde" Margin="0,0,8,0"/>
    <TextBox Grid.Column="1" Text="{Binding ThroughDate,UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Fecha hasta" Margin="8,0"/>
    <Button Grid.Column="2" Content="Buscar fechas" Click="SearchDatesClick" Margin="8,0"/>
    <Button Grid.Column="3" Content="Limpiar" Click="ClearClick" Margin="8,0,0,0"/>
   </Grid>
   <DataGrid x:Name="SalesList" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}" Height="260" AutomationProperties.Name="Historial de ventas" HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="260"/>
     <DataGridTextColumn Header="Fecha local" Binding="{Binding Date}" Width="175"/>
     <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
     <DataGridTextColumn Header="Pago" Binding="{Binding Method}" Width="80"/>
     <DataGridTextColumn Header="Cajero actual" Binding="{Binding Cashier}" Width="150"/>
     <DataGridTextColumn Header="Terminal actual" Binding="{Binding Terminal}" Width="160"/>
     <DataGridTextColumn Header="CashSessionId" Binding="{Binding CashSession}" Width="300"/>
    </DataGrid.Columns>
   </DataGrid>
   <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Ver detalle" Click="DetailClick" Margin="12,0,0,0"/><WrapPanel DockPanel.Dock="Right"><Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding HasPrevious}" Margin="0,0,8,0"/><Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding HasNext}"/></WrapPanel><TextBlock Text="{Binding PageLabel}" FontSize="15" VerticalAlignment="Center"/></DockPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsDetail,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{Binding DetailTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding DetailContext}" FontSize="16" Margin="0,0,0,14"/>
   <DataGrid ItemsSource="{Binding DetailItems}" Height="230" AutomationProperties.Name="Partidas de venta" HorizontalScrollBarVisibility="Auto">
    <DataGrid.Columns>
     <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45"/>
     <DataGridTextColumn Header="ProductId" Binding="{Binding ProductId}" Width="300"/>
     <DataGridTextColumn Header="Nombre vendido" Binding="{Binding Name}" Width="*" MinWidth="180"/>
     <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice}" Width="100"/>
     <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
     <DataGridTextColumn Header="Total línea" Binding="{Binding LineTotal}" Width="110"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="{Binding DetailPayment}" FontSize="18" Margin="0,14,0,14"/>
   <Button Content="Volver" Click="BackClick" HorizontalAlignment="Left"/>
  </StackPanel>
  <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0"/>
 </StackPanel>
</UserControl>
