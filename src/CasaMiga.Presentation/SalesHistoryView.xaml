<UserControl x:Class="CasaMiga.Presentation.SalesHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CasaMiga.Presentation" PreviewKeyDown="HistoryKeyDown">
 <Grid IsEnabled="{Binding Ready}">
  <Grid Visibility="{Binding IsList,Converter={StaticResource VisibleWhen}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel Margin="0,0,0,10">
    <Button Content="Todos" Click="AllClick" Tag="{Binding IsAllFilter}" Style="{StaticResource SectionTabButton}" Margin="0,0,8,4"/>
    <Button Content="Hoy" Click="TodayClick" Tag="{Binding IsTodayFilter}" Style="{StaticResource SectionTabButton}" Margin="0,0,8,4"/>
    <Button Content="Ayer" Click="YesterdayClick" Tag="{Binding IsYesterdayFilter}" Style="{StaticResource SectionTabButton}" Margin="0,0,8,4"/>
    <Button Content="Sesión actual" Click="CurrentSessionClick" Tag="{Binding IsSessionFilter}" Style="{StaticResource SectionTabButton}" Margin="0,0,8,4"/>
    <!-- Folio corto de la caja (C01-001061) o sólo el número. -->
    <TextBox x:Name="FolioBox" Text="{Binding Folio,UpdateSourceTrigger=PropertyChanged}" Width="190" MaxLength="64" Margin="16,0,8,4" KeyDown="FolioKeyDown"
             AutomationProperties.Name="Folio" ToolTip="Folio, por ejemplo C01-001061 o sólo 1061"/>
    <Button Content="Buscar folio" Click="SearchFolioClick" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4"/>
   </WrapPanel>
   <Border Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <local:DateEntryControl x:Name="FromDateEntry" Grid.Column="1" Text="{Binding FromDateText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HasError="{Binding HasFromDateError}" AutomationName="Fecha desde" EntryCommitted="FromDateCommitted"/>
     <TextBlock Grid.Column="2" Text="Hasta" VerticalAlignment="Center" Margin="16,0,8,0"/>
     <local:DateEntryControl x:Name="ThroughDateEntry" Grid.Column="3" Text="{Binding ThroughDateText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HasError="{Binding HasThroughDateError}" AutomationName="Fecha hasta" EntryCommitted="ThroughDateCommitted"/>
     <Button Grid.Column="4" Content="Aplicar rango" Click="SearchDatesClick" Margin="16,0,0,0" MinWidth="130"/>
     <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FromDateError}" Foreground="{DynamicResource ErrorBrush}" Margin="2,5,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ThroughDateError}" Foreground="{DynamicResource ErrorBrush}" Margin="2,5,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DateRangeError}" Foreground="{DynamicResource ErrorBrush}" Margin="2,5,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="{Binding FilterSummary}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="16" HorizontalAlignment="Center" Visibility="{Binding HasNoSales,Converter={StaticResource VisibleWhen}}"/></Grid>
   <DataGrid Grid.Row="3" x:Name="SalesList" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}" MinHeight="260" AutomationProperties.Name="Historial de ventas" HorizontalScrollBarVisibility="Disabled">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Venta" Binding="{Binding SaleNumber}" Width="145"/>
     <DataGridTextColumn Header="Fecha y hora" Binding="{Binding Date}" Width="155"/>
     <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/>
     <DataGridTextColumn Header="Devuelto" Binding="{Binding Refunded}" Width="95"/>
     <DataGridTextColumn Header="Pago" Binding="{Binding Method}" Width="110"/>
     <DataGridTextColumn Header="Responsable" Binding="{Binding Cashier}" Width="*" MinWidth="145"/>
     <DataGridTextColumn Header="Caja" Binding="{Binding Terminal}" Width="160"/>
    </DataGrid.Columns>
   </DataGrid>
   <DockPanel Grid.Row="4" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Ver detalle" Click="DetailClick" Margin="12,0,0,0"/><WrapPanel DockPanel.Dock="Right"><Button Content="Anterior" Click="PreviousClick" IsEnabled="{Binding HasPrevious}" Margin="0,0,8,0"/><Button Content="Siguiente" Click="NextClick" IsEnabled="{Binding HasNext}"/></WrapPanel><TextBlock Text="{Binding PageLabel}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
  </Grid>
  <ScrollViewer Visibility="{Binding IsDetail,Converter={StaticResource VisibleWhen}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding DetailTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Grid.Row="1" Text="{Binding DetailContext}" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap"/>
   <DataGrid Grid.Row="2" ItemsSource="{Binding DetailItems}" MinHeight="230" MaxHeight="320" AutomationProperties.Name="Partidas de venta" HorizontalScrollBarVisibility="Disabled">
    <DataGrid.Columns>
     <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45"/>
     <DataGridTextColumn Header="Producto vendido" Binding="{Binding Name}" Width="*" MinWidth="260"/>
     <DataGridTextColumn Header="Precio unitario" Binding="{Binding UnitPrice}" Width="125"/>
     <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="110"/>
     <DataGridTextColumn Header="Importe" Binding="{Binding LineTotal}" Width="125"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="3" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="12" Margin="0,10,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Subtotal" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding DetailSubtotal}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Total" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding DetailTotal}" FontSize="20" FontWeight="Bold"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Pago" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding DetailPaymentMethod}" FontSize="18"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="Recibido" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding DetailReceived}" FontSize="18"/></StackPanel>
     <StackPanel Grid.Column="4"><TextBlock Text="Cambio" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding DetailChange}" FontSize="18"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Volver" Click="BackClick" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><Button Content="{Binding ReprintButtonText}" Click="ReprintClick" IsEnabled="{Binding CanReprintTicket}" Visibility="{Binding ShowReprintTicket,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Reimprimir ticket"/><TextBlock Text="{Binding ReprintMessage}" AutomationProperties.LiveSetting="Polite" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
   <StackPanel Grid.Row="5" Visibility="{Binding ShowRefunds,Converter={StaticResource VisibleWhen}}" Margin="0,20,0,0">
    <TextBlock Text="Cancelaciones y devoluciones" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding RefundHistory}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding RefundBlocker}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid ItemsSource="{Binding RefundLines}" Height="180" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" AutomationProperties.Name="Piezas a devolver">
     <DataGrid.Columns>
      <DataGridTextColumn Header="#" Binding="{Binding Position,Mode=OneWay}" Width="45" IsReadOnly="True"/>
      <DataGridTextColumn Header="Producto" Binding="{Binding Name,Mode=OneWay}" Width="*" MinWidth="180" IsReadOnly="True"/>
      <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice,Mode=OneWay}" Width="100" IsReadOnly="True"/>
      <DataGridTextColumn Header="Vendidas" Binding="{Binding Sold,Mode=OneWay}" Width="90" IsReadOnly="True"/>
      <DataGridTextColumn Header="Ya devueltas" Binding="{Binding Refunded,Mode=OneWay}" Width="110" IsReadOnly="True"/>
      <DataGridTextColumn Header="Disponibles" Binding="{Binding Remaining,Mode=OneWay}" Width="100" IsReadOnly="True"/>
      <DataGridTextColumn Header="A devolver" Binding="{Binding ToReturn,UpdateSourceTrigger=PropertyChanged}" Width="110"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="Motivo (obligatorio)" Margin="0,12,0,0"/>
    <TextBox Text="{Binding RefundReason,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Motivo de cancelación o devolución" Margin="0,6,0,8"/>
    <TextBlock Text="{Binding RefundMediumNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <WrapPanel>
     <Button Content="Devolver piezas indicadas" Click="ReturnItemsClick" IsEnabled="{Binding CanReturnItems}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/>
     <Button Content="Cancelar venta completa" Click="CancelSaleClick" IsEnabled="{Binding CanCancelSale}" Style="{StaticResource DestructiveButton}" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock Text="{Binding RefundMessage}" TextWrapping="Wrap" FontSize="16" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding RefundSucceeded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </Grid>
  </ScrollViewer>
  <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" VerticalAlignment="Bottom"/>
 </Grid>
</UserControl>
