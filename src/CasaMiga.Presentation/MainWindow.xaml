<Window x:Class="CasaMiga.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CasaMiga.Presentation" Title="Casa Miga POS · Caja" Icon="/CasaMiga.Presentation;component/Assets/CasaMiga.ico" Width="1280" Height="820" MinWidth="960" MinHeight="640" Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterScreen" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" Loaded="WindowLoaded" Closed="WindowClosed" Deactivated="WindowDeactivated" StateChanged="WindowStateChanged" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid>
  <!-- Acceso y preparación: el shell operativo aparece sólo después de autenticar. -->
  <ScrollViewer Visibility="{Binding IsSignedOut,Converter={StaticResource VisibleWhen}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid MinHeight="{Binding ViewportHeight,RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
   <Grid Margin="24,16" MaxWidth="1240" VerticalAlignment="Center">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="570"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource AvocadoLeafBrush}" CornerRadius="24" Padding="36" Margin="0,0,0,0">
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="HECHO EN CASA MIGA" Foreground="{DynamicResource NaturalBackgroundBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="Cada día,&#10;un buen comienzo." Foreground="{DynamicResource NaturalBackgroundBrush}" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Border Width="48" Height="3" Background="{DynamicResource WheatBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <TextBlock Text="Tu panadería, en orden." Foreground="{DynamicResource NaturalBackgroundBrush}" FontSize="20"/>
      <TextBlock Text="Ventas, caja y producción en un solo lugar." Foreground="{DynamicResource NaturalBackgroundBrush}" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
     <Image Source="/CasaMiga.Presentation;component/Assets/CasaMigaLogo.png" Width="165.552" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" HorizontalAlignment="Center" Margin="0,0,0,12" AutomationProperties.Name="Logo oficial Casa Miga"/>
     <Border Style="{StaticResource CardStyle}" BorderThickness="0" Padding="20">
      <StackPanel>
       <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleText}" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
       <Grid Visibility="{Binding IsBootstrap,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Usuario administrador"/><TextBox x:Name="BootstrapUser" AutomationProperties.Name="Usuario administrador" MaxLength="80" Margin="0,6,0,14"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Nombre para mostrar"/><TextBox x:Name="BootstrapName" AutomationProperties.Name="Nombre para mostrar" MaxLength="100" Margin="0,6,0,14"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="Contraseña"/><PasswordBox x:Name="BootstrapPassword" AutomationProperties.Name="Contraseña inicial" MaxLength="128" Margin="0,6,0,8"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Confirmar contraseña"/><PasswordBox x:Name="BootstrapConfirmation" AutomationProperties.Name="Confirmar contraseña" MaxLength="128" Margin="0,6,0,8"/></StackPanel>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Elige una contraseña de 12 a 128 caracteres y escríbela igual en ambos campos." Style="{StaticResource CaptionText}" Margin="0,0,0,16"/>
        <Button Grid.Row="3" Grid.ColumnSpan="3" Content="Crear administrador" Click="BootstrapClick"/>
       </Grid>
       <Grid Visibility="{Binding IsLogin,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Usuario"/><TextBox x:Name="LoginUser" AutomationProperties.Name="Usuario" MaxLength="80" Margin="0,6,0,16"/>
         <TextBlock Text="Contraseña"/><PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Contraseña" MaxLength="128" Margin="0,6,0,24" KeyDown="LoginPasswordKeyDown"/>
         <Button Content="Entrar" Click="LoginClick"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource AvocadoLeafBrush}" CornerRadius="14" Padding="14" VerticalAlignment="Stretch" AutomationProperties.Name="Hora local">
         <StackPanel VerticalAlignment="Center"><TextBlock Text="HORA LOCAL" Foreground="White" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Operations.ClockTime}" Foreground="White" FontSize="34" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="{Binding Operations.ClockDate}" Foreground="White" FontSize="14"/></StackPanel>
        </Border>
       </Grid>
       <TextBlock Text="{Binding Message}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Text="Procesando…" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding Busy,Converter={StaticResource VisibleWhen}}"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Aplicación local · Versión de desarrollo" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
   </Grid>
  </ScrollViewer>

  <!-- Shell operativo 1K.1 -->
  <Grid Visibility="{Binding CanNavigate,Converter={StaticResource VisibleWhen}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.ColumnSpan="2" Height="5" VerticalAlignment="Top" Background="{StaticResource AvocadoLeafBrush}" Panel.ZIndex="5"/>
   <Border Background="{StaticResource AvocadoLeafBrush}" BorderBrush="{DynamicResource WheatBrush}" BorderThickness="0,0,1,0">
    <Grid Margin="10,14,10,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource NaturalBackgroundBrush}" CornerRadius="16" Padding="10" Margin="0,0,0,8">
      <Image Source="/CasaMiga.Presentation;component/Assets/CasaMigaLogo.png" MaxWidth="176" Height="72" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" HorizontalAlignment="Center" AutomationProperties.Name="Logo oficial Casa Miga"/>
     </Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="{Binding SidebarScrollBarVisibility}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel IsEnabled="{Binding IsReady}">
       <Button Content="Expandir" Tag="M4,4 L16,10 4,16" Click="TogglePosSidebarClick" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsPosSidebarCompact,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Expandir navegación"/>
       <Button Content="Contraer navegación" Tag="M16,4 L4,10 16,16" Click="TogglePosSidebarClick" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsPosSidebarExpanded,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Contraer navegación"/>
       <TextBlock Text="OPERACIÓN" Style="{StaticResource SidebarGroupText}"/>
       <Button Tag="M2,3 L18,3 18,14 2,14 Z M6,18 L14,18 M10,14 L10,18" Content="Punto de venta" Click="PosNavigationClick" AutomationProperties.Name="Ir a Punto de venta"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPos}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="M2,7 L18,7 18,18 2,18 Z M5,7 L5,2 15,2 15,7 M7,12 L13,12" Content="Caja" Click="CashNavigationClick" AutomationProperties.Name="Ir a Caja"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDashboard}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding IsOpening}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsCounting}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsClosingResult}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <TextBlock Text="GESTIÓN" Style="{StaticResource SidebarGroupText}"/>
       <Button Tag="M2,2 L8,2 8,8 2,8 Z M12,2 L18,2 18,8 12,8 Z M2,12 L8,12 8,18 2,18 Z M12,12 L18,12 18,18 12,18 Z" Content="Catálogo" Click="CatalogNavigationClick" AutomationProperties.Name="Ir a Catálogo"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCatalog}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="M2,6 L10,2 18,6 10,10 Z M2,6 L2,15 10,19 18,15 18,6 M10,10 L10,19" Content="Inventario" Click="InventoryNavigationClick" Visibility="{Binding CanViewInventory,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Inventario"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsInventory}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="M2,3 Q6,1 10,4 Q14,1 18,3 L18,17 Q14,15 10,18 Q6,15 2,17 Z M10,4 L10,18" Content="Recetas" Click="RecipesNavigationClick" Visibility="{Binding CanViewRecipes,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Recetas"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRecipes}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="M2,18 L2,9 7,5 7,9 12,5 12,10 18,10 18,18 Z M14,10 L14,2 17,2 17,10 M5,14 L7,14 M11,14 L13,14" Content="Producción" Click="ProductionNavigationClick" Visibility="{Binding CanViewProduction,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Producción"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsProduction}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <StackPanel Visibility="{Binding CanViewSales,Converter={StaticResource VisibleWhen}}"><TextBlock Text="CONSULTA" Style="{StaticResource SidebarGroupText}"/></StackPanel>
       <Button Tag="M4,2 L16,2 16,18 4,18 Z M7,6 L13,6 M7,10 L13,10 M7,14 L11,14" Content="Historial de ventas" Click="SalesNavigationClick" Visibility="{Binding CanViewSales,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Historial de ventas"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSalesHistory}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="2">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,10"/>
      <Button Content="Salir de mi usuario" Click="LogoutClick" Tag="M8,2 L2,2 2,18 8,18 M7,10 L18,10 M14,6 L18,10 14,14" Style="{StaticResource SidebarNavButton}" Foreground="{DynamicResource NaturalBackgroundBrush}" HorizontalContentAlignment="Left" MinWidth="0" AutomationProperties.Name="Salir de mi usuario"/>
      <TextBlock Text="Versión de desarrollo" Style="{StaticResource CaptionText}" Foreground="{DynamicResource NaturalBackgroundBrush}" Margin="12,6,0,0" Visibility="{Binding IsNotPos,Converter={StaticResource VisibleWhen}}"/>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
     <StackPanel>
      <DockPanel LastChildFill="True">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
        <Button x:Name="OperationsButton" Click="OperationsClick" Style="{StaticResource SecondaryButton}" MinWidth="144" MinHeight="40" Padding="11,5" Margin="0,0,8,0" ToolTip="Centro operativo" AutomationProperties.Name="Centro operativo" AutomationProperties.LiveSetting="Assertive">
         <StackPanel Orientation="Horizontal"><Path Data="M12,3 A9,9 0 1 1 11.99,3 M12,7 L12,12 16,14" Width="17" Height="17" Stretch="Fill" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,7,0"/><TextBlock Text="{Binding Operations.ClockTime}" FontWeight="SemiBold"/><TextBlock Text="{Binding Operations.ClockDate}" FontSize="13" VerticalAlignment="Center" Margin="7,0,0,0"/><Border Background="{StaticResource AvocadoLeafBrush}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0" Visibility="{Binding Operations.HasHeaderStatus,Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding Operations.HeaderStatus}" Foreground="White" FontSize="12"/></Border></StackPanel>
        </Button>
        <Button x:Name="FullScreenButton" Content="Pantalla completa · F11" Click="FullScreenClick" Style="{StaticResource SecondaryButton}" MinWidth="174" MinHeight="40" Padding="12,7" VerticalAlignment="Top" AutomationProperties.Name="Alternar pantalla completa"/>
       </StackPanel>
       <StackPanel><TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleText}"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
      </DockPanel>
      <WrapPanel HorizontalAlignment="Left" Margin="-6,7,0,0">
       <Border Style="{StaticResource StatusPill}"><StackPanel><TextBlock Text="{Binding CurrentUserName}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding CurrentRoleLabel}" Style="{StaticResource CaptionText}"/></StackPanel></Border>
       <Border Style="{StaticResource StatusPill}"><StackPanel><TextBlock Text="Terminal" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding CurrentTerminalName}" FontWeight="SemiBold" FontSize="14"/></StackPanel></Border>
      </WrapPanel>
     </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="{Binding ShellContentMargin}">
     <ScrollViewer Visibility="{Binding IsScrollableContent,Converter={StaticResource VisibleWhen}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
       <StackPanel>
        <local:CatalogView DataContext="{Binding Catalog}" Visibility="{Binding DataContext.IsCatalog,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:SalesHistoryView DataContext="{Binding SalesHistory}" Visibility="{Binding DataContext.IsSalesHistory,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:InventoryView DataContext="{Binding Inventory}" Visibility="{Binding DataContext.IsInventory,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:RecipeView DataContext="{Binding Recipes}" Visibility="{Binding DataContext.IsRecipes,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:ProductionView DataContext="{Binding Production}" Visibility="{Binding DataContext.IsProduction,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <StackPanel Visibility="{Binding IsOpening,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}" MaxWidth="650" HorizontalAlignment="Left">
         <TextBlock Text="Fondo inicial en MXN"/><TextBox x:Name="OpeningAmount" AutomationProperties.Name="Fondo inicial en MXN" Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,8,0,8"/>
         <TextBlock Text="Ejemplo: 500.00 · Se permite iniciar con $0.00" Style="{StaticResource CaptionText}" Margin="0,0,0,24"/>
         <WrapPanel><Button Content="Cancelar" Click="CancelOpeningClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button Content="Confirmar apertura" Click="OpenClick" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsCounting,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}" MaxWidth="650" HorizontalAlignment="Left">
         <TextBlock Text="{Binding ClosingOwner}" Margin="0,0,0,16"/><TextBlock Text="Efectivo contado en MXN"/><TextBox x:Name="CountedInput" AutomationProperties.Name="Efectivo contado en MXN" Text="{Binding CountedAmount,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,8,0,24"/>
         <WrapPanel><Button Content="Cancelar" Click="BackClosingClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button Content="Confirmar conteo" Click="SubmitCountClick" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsClosingResult,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}" MaxWidth="780" HorizontalAlignment="Left">
         <TextBlock Text="{Binding ClosingOwner}" Margin="0,0,0,10"/>
         <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,14"><TextBlock Text="{Binding ClosingDetails}" FontSize="18" LineHeight="27"/></Border>
         <TextBlock Text="La sesión quedará cerrada y auditada. No podrá volver a abrirse. Volver conserva el conteo confirmado." Margin="0,0,0,14"/>
         <TextBlock x:Name="NoDiscrepancyNoteMessage" Text="Sin diferencia. No se requiere nota." FontSize="15" Margin="0,0,0,12">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding RequiresDiscrepancyNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <StackPanel x:Name="DiscrepancyNoteEditor" Visibility="{Binding RequiresDiscrepancyNote,Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="{Binding DiscrepancyNoteLabel}" FontWeight="SemiBold"/>
          <TextBlock Text="Escribe una nota para habilitar el cierre." Style="{StaticResource CaptionText}" Margin="0,2,0,4"/>
          <TextBox Text="{Binding DiscrepancyNote,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Nota de discrepancia" Margin="0,2,0,4"/>
          <TextBlock Text="{Binding DiscrepancyNoteCount}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
         </StackPanel>
         <WrapPanel><Button x:Name="BackResult" Content="Volver" Click="BackClosingClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button Content="Confirmar cierre definitivo" IsEnabled="{Binding CanConfirmClose}" Click="ConfirmCloseClick" Style="{StaticResource DestructiveButton}" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <TextBlock Text="{Binding Message}" Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel>
      </Border>
     </ScrollViewer>
     <Border Style="{StaticResource CardStyle}" Padding="20" Visibility="{Binding IsDashboard,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Grid MaxWidth="1120" HorizontalAlignment="Stretch">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Visibility="{Binding ShowsCashDashboard,Converter={StaticResource VisibleWhen}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="{Binding CashLabel}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" Margin="0,0,0,5"/>
         <TextBlock Text="{Binding CashDetails}" Margin="0,0,16,5"/>
         <TextBlock Text="Salir del usuario o cerrar la aplicación no cierra la caja." Style="{StaticResource CaptionText}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
         <Button Content="Abrir caja" Click="ShowOpeningClick" IsEnabled="{Binding CanOpen}" Visibility="{Binding CanOpen,Converter={StaticResource VisibleWhen}}"/>
         <Button Content="Cerrar caja" Click="BeginClosingClick" Visibility="{Binding CanClose,Converter={StaticResource VisibleWhen}}" Style="{StaticResource DestructiveButton}"/>
        </StackPanel>
       </Grid>
       <local:CashHistoryView Grid.Row="1"/>
      </Grid>
     </Border>
     <local:PosView DataContext="{Binding Pos}" Visibility="{Binding DataContext.IsPos,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}" CashRequested="PosCashRequested" CatalogRequested="PosCatalogRequested" SalesRequested="PosSalesRequested" InventoryRequested="PosInventoryRequested" RecipesRequested="PosRecipesRequested" ProductionRequested="PosProductionRequested" LogoutRequested="PosLogoutRequested"/>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,8">
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="Procesando…" Style="{StaticResource CaptionText}" Visibility="{Binding Busy,Converter={StaticResource VisibleWhen}}"/><TextBlock Text="Casa Miga · Operación local" Style="{StaticResource CaptionText}"/></DockPanel>
    </Border>
   </Grid>
  </Grid>
  <Grid Panel.ZIndex="90" Visibility="{Binding Operations.IsPanelOpen,Converter={StaticResource VisibleWhen}}">
   <Border Background="#52000000" MouseLeftButtonDown="OperationsBackdropClick"/>
   <local:OperationCenterView DataContext="{Binding Operations}" Width="420" MaxWidth="420" HorizontalAlignment="Right" AutomationProperties.Name="Centro operativo"/>
  </Grid>
 </Grid>
</Window>
