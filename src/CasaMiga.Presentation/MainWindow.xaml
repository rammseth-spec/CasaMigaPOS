<Window x:Class="CasaMiga.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CasaMiga.Presentation" Title="Casa Miga POS · Caja" Icon="/CasaMiga.Presentation;component/Assets/CasaMiga.ico" Width="1280" Height="820" MinWidth="960" MinHeight="640" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource TextFont}" WindowStartupLocation="CenterScreen" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <!-- Etiqueta de campo del acceso: un poco más chica y seminegrita, como en el diseño A. -->
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid>
  <!-- Acceso y preparación: el shell operativo aparece sólo después de autenticar. Panel de marca con hora, fecha y estado; el formulario a la derecha. -->
  <ScrollViewer Visibility="{Binding IsSignedOut,Converter={StaticResource VisibleWhen}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid MinHeight="{Binding ViewportHeight,RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="360"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource AvocadoLeafBrush}">
     <Grid Margin="48,44,48,40">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource NaturalBackgroundBrush}" CornerRadius="20" Padding="22,14" HorizontalAlignment="Left">
       <Image Source="/CasaMiga.Presentation;component/Assets/CasaMigaLogo.png" Width="138" Height="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" AutomationProperties.Name="Logo oficial Casa Miga"/>
      </Border>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,28">
       <TextBlock Text="{Binding SignInTime}" FontFamily="{StaticResource DisplayFont}" FontSize="104" FontWeight="SemiBold" Foreground="{DynamicResource NaturalBackgroundBrush}" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Hora"/>
       <TextBlock Text="{Binding SignInDate}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource NaturalBackgroundBrush}" Opacity="0.92" Margin="4,0,0,0"/>
       <Border Width="56" Height="3" CornerRadius="1.5" Background="{DynamicResource WheatBrush}" HorizontalAlignment="Left" Margin="4,24,0,16"/>
       <TextBlock Text="Cada día, un buen comienzo." FontSize="18" Foreground="{DynamicResource NaturalBackgroundBrush}" Opacity="0.85" Margin="4,0,0,0"/>
      </StackPanel>
      <WrapPanel Grid.Row="2">
       <Border Style="{StaticResource SignInChip}" Visibility="{Binding HasSignInCashLabel,Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding SignInCashLabel}" Style="{StaticResource SignInChipText}"/></Border>
       <Border Style="{StaticResource SignInChip}" DataContext="{Binding Sync}"><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource SignInChipText}"/></Border>
       <Border Style="{StaticResource SignInChip}"><TextBlock Text="{Binding CurrentTerminalName}" Style="{StaticResource SignInChipText}"/></Border>
      </WrapPanel>
     </Grid>
    </Border>
    <Grid Grid.Column="1">
     <StackPanel MaxWidth="440" Margin="48,40" VerticalAlignment="Center">
      <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,26"/>
      <Grid Visibility="{Binding IsBootstrap,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="Usuario administrador" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BootstrapUser" AutomationProperties.Name="Usuario administrador" MaxLength="80" Margin="0,6,0,14"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Nombre para mostrar" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BootstrapName" AutomationProperties.Name="Nombre para mostrar" MaxLength="100" Margin="0,6,0,14"/></StackPanel>
       <StackPanel Grid.Row="1"><TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/><local:PasswordInput x:Name="BootstrapPassword" AutomationProperties.Name="Contraseña inicial" MaxLength="16" Margin="0,6,0,8" PasswordChanged="BootstrapPasswordChanged" KeyDown="BootstrapKeyDown"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Confirmar contraseña" Style="{StaticResource FieldLabel}"/><local:PasswordInput x:Name="BootstrapConfirmation" AutomationProperties.Name="Confirmar contraseña" MaxLength="16" Margin="0,6,0,8" PasswordChanged="BootstrapPasswordChanged" KeyDown="BootstrapKeyDown"/></StackPanel>
       <local:PasswordChecklist x:Name="BootstrapChecklist" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,2,0,16"/>
       <Button x:Name="BootstrapButton" Grid.Row="3" Grid.ColumnSpan="3" Content="Crear administrador" Click="BootstrapClick" IsEnabled="False" MinHeight="52"/>
      </Grid>
      <StackPanel Visibility="{Binding IsLogin,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}">
       <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoginUser" AutomationProperties.Name="Usuario" MaxLength="80" Margin="0,6,0,16"/>
       <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/><local:PasswordInput x:Name="LoginPassword" AutomationProperties.Name="Contraseña" MaxLength="128" Margin="0,6,0,24" KeyDown="LoginPasswordKeyDown"/>
       <Button Content="Entrar" Click="LoginClick" MinHeight="54" FontSize="17"/>
       <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
        <Button Content="¿Olvidaste tu contraseña?" Click="ForgotPasswordClick" Style="{StaticResource GhostButton}" Margin="0,0,8,0" AutomationProperties.Name="Olvidé mi contraseña"/>
        <Button Content="Cambiar contraseña" Click="ShowChangePasswordClick" Style="{StaticResource GhostButton}" AutomationProperties.Name="Cambiar contraseña"/>
       </WrapPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding IsChangePassword,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}">
       <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ChangeUser" Text="{Binding ChangePasswordUser,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usuario" MaxLength="80" Margin="0,6,0,14"/>
       <TextBlock Text="Contraseña actual o temporal" Style="{StaticResource FieldLabel}"/><local:PasswordInput x:Name="ChangeCurrent" AutomationProperties.Name="Contraseña actual o temporal" MaxLength="128" Margin="0,6,0,14"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Contraseña nueva" Style="{StaticResource FieldLabel}"/><local:PasswordInput x:Name="ChangeNew" AutomationProperties.Name="Contraseña nueva" MaxLength="16" Margin="0,6,0,8" PasswordChanged="ChangePasswordChanged" KeyDown="ChangeKeyDown"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Confirmar contraseña nueva" Style="{StaticResource FieldLabel}"/><local:PasswordInput x:Name="ChangeConfirmation" AutomationProperties.Name="Confirmar contraseña nueva" MaxLength="16" Margin="0,6,0,8" PasswordChanged="ChangePasswordChanged" KeyDown="ChangeKeyDown"/></StackPanel>
       </Grid>
       <local:PasswordChecklist x:Name="ChangeChecklist" Margin="0,2,0,16"/>
       <WrapPanel><Button Content="Cancelar" Click="CancelChangePasswordClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button x:Name="ChangeSaveButton" Content="Guardar contraseña" Click="ChangePasswordClick" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel>
      <TextBlock Text="{Binding Message}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="Procesando…" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding Busy,Converter={StaticResource VisibleWhen}}"/>
      <TextBlock Text="Aplicación local · Versión de desarrollo" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,28,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>
  </ScrollViewer>

  <!-- Shell operativo (rediseño A): riel blanco con íconos, barra superior con estado y contenido sobre el fondo cálido. -->
  <Grid Visibility="{Binding CanNavigate,Converter={StaticResource VisibleWhen}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
    <Grid Margin="8,14,8,10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Image Source="/CasaMiga.Presentation;component/Assets/CasaMigaLogo.png" Width="72" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" HorizontalAlignment="Center" Margin="0,0,0,10" AutomationProperties.Name="Logo oficial Casa Miga"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <StackPanel IsEnabled="{Binding IsReady}">
       <Button Tag="{StaticResource IconSale}" Content="Venta" Click="PosNavigationClick" AutomationProperties.Name="Ir a Punto de venta"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsPos}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconCash}" Content="Caja" Click="CashNavigationClick" AutomationProperties.Name="Ir a Caja"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDashboard}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsOpening}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsCounting}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsClosingResult}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconTray}" Content="Charolas" Click="ConsignmentNavigationClick" Visibility="{Binding CanViewConsignment,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Charolas"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsConsignment}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="14,6" Visibility="{Binding CanViewSales,Converter={StaticResource VisibleWhen}}"/>
       <Button Tag="{StaticResource IconReceipt}" Content="Ventas" Click="SalesNavigationClick" Visibility="{Binding CanViewSales,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Historial de ventas"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSalesHistory}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconChart}" Content="Reportes" Click="ReportsNavigationClick" Visibility="{Binding CanViewSales,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Reportes"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsReports}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="14,6"/>
       <Button Tag="{StaticResource IconGrid}" Content="Catálogo" Click="CatalogNavigationClick" AutomationProperties.Name="Ir a Catálogo"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCatalog}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconBox}" Content="Inventario" Click="InventoryNavigationClick" Visibility="{Binding CanViewInventory,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Inventario"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsInventory}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconBook}" Content="Recetas" Click="RecipesNavigationClick" Visibility="{Binding CanViewRecipes,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Recetas"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRecipes}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconChef}" Content="Producción" Click="ProductionNavigationClick" Visibility="{Binding CanViewProduction,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Producción"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsProduction}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconUsers}" Content="Usuarios" Click="UsersNavigationClick" Visibility="{Binding CanManageUsers,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Usuarios"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsUsers}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Tag="{StaticResource IconCloud}" Content="Nube" Click="SyncNavigationClick" Visibility="{Binding CanManageUsers,Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="Ir a Nube"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSync}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="2">
      <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="12,6,12,6"/>
      <Button Content="Salir" Click="LogoutClick" Tag="{StaticResource IconLogout}" Style="{StaticResource SidebarNavButton}" AutomationProperties.Name="Salir de mi usuario"/>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="24,14,16,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
      <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontSize="13.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" Margin="0,1,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="Procesando…" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{Binding Busy,Converter={StaticResource VisibleWhen}}"/>
      <Border Style="{StaticResource StatusPill}">
       <StackPanel Orientation="Horizontal">
        <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}"><Style.Triggers><DataTrigger Binding="{Binding HasOpenCash}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
        <TextBlock Text="{Binding CashStatusLabel}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource StatusPill}" DataContext="{Binding Sync}" ToolTip="{Binding StatusDetail}">
       <StackPanel Orientation="Horizontal">
        <Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}"><Style.Triggers><DataTrigger Binding="{Binding IsUpToDate}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding NeedsCheck}" Value="True"><Setter Property="Fill" Value="#C77C00"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
        <TextBlock Text="{Binding StatusLabel}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource StatusPill}" Padding="4,4,14,4">
       <StackPanel Orientation="Horizontal">
        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PrimaryBrush}"><TextBlock Text="{Binding UserInitials}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/></Border>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
         <TextBlock Text="{Binding CurrentUserName}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"/>
         <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap"><Run Text="{Binding CurrentRoleLabel,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding CurrentTerminalName,Mode=OneWay}"/></TextBlock>
        </StackPanel>
       </StackPanel>
      </Border>
      <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconExpand}" Click="FullScreenClick" ToolTip="Pantalla completa · F11" Margin="8,0,0,0" AutomationProperties.Name="Alternar pantalla completa"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="{Binding ShellContentMargin}">
     <ScrollViewer Visibility="{Binding IsNotPos,Converter={StaticResource VisibleWhen}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
      <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
       <StackPanel>
        <local:CatalogView DataContext="{Binding Catalog}" Visibility="{Binding DataContext.IsCatalog,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:SalesHistoryView DataContext="{Binding SalesHistory}" Visibility="{Binding DataContext.IsSalesHistory,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:ReportsView DataContext="{Binding Reports}" Visibility="{Binding DataContext.IsReports,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:ConsignmentView DataContext="{Binding Consignment}" Visibility="{Binding DataContext.IsConsignment,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <StackPanel DataContext="{Binding Sync}" Visibility="{Binding DataContext.IsSync,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}" MaxWidth="720" HorizontalAlignment="Left">
         <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource SectionTitleText}" FontSize="24" Margin="0,0,0,6"/>
         <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,22"/>
         <TextBlock Text="Registrar esta terminal" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
         <StackPanel IsEnabled="{Binding Ready}">
          <TextBlock Text="Dirección del servidor" FontSize="14" FontWeight="SemiBold"/><TextBox Text="{Binding ApiUrl,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Dirección del servidor" Margin="0,6,0,14"/>
          <TextBlock Text="Nombre de esta sucursal" FontSize="14" FontWeight="SemiBold"/><TextBox Text="{Binding BranchName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nombre de la sucursal" Margin="0,6,0,14"/>
          <TextBlock Text="Secreto de alta (lo tiene el administrador)" FontSize="14" FontWeight="SemiBold"/><local:PasswordInput x:Name="EnrollmentSecret" MaxLength="200" AutomationProperties.Name="Secreto de alta" Margin="0,6,0,14"/>
          <WrapPanel><Button Content="Registrar terminal" Click="RegisterTerminalClick" Margin="0,0,12,8"/><Button Content="Sincronizar ahora" Click="SyncNowClick" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
          <TextBlock Text="Volver a registrar genera una llave nueva y desactiva la anterior. Una terminal no puede cambiar de sucursal." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
         </StackPanel>
         <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <local:InventoryView DataContext="{Binding Inventory}" Visibility="{Binding DataContext.IsInventory,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:RecipeView DataContext="{Binding Recipes}" Visibility="{Binding DataContext.IsRecipes,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <local:ProductionView DataContext="{Binding Production}" Visibility="{Binding DataContext.IsProduction,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        <!-- Caja: estado grande con punto de color, detalle y la acción que corresponde. -->
        <!-- Con caja abierta, a la derecha (o debajo si no cabe) van los gastos, entradas y retiros del turno. -->
        <WrapPanel Visibility="{Binding IsDashboard,Converter={StaticResource VisibleWhen}}">
        <StackPanel IsEnabled="{Binding IsReady}" Width="420" Margin="0,0,28,24">
         <TextBlock Text="{Binding CashLabel}" Style="{StaticResource EyebrowText}" Margin="0,0,0,4"/>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,4,12,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource StatusIdleBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasOpenCash}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
          <TextBlock Text="{Binding CashStatusLabel}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"/>
         </StackPanel>
         <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="14" Padding="18,14" Margin="0,0,0,20"><TextBlock Text="{Binding CashDetails}" LineHeight="23"/></Border>
         <Button Content="Abrir caja" Click="ShowOpeningClick" IsEnabled="{Binding CanOpen}" Visibility="{Binding HasNoOpenCash,Converter={StaticResource VisibleWhen}}" HorizontalAlignment="Left" MinWidth="220" MinHeight="52" Margin="0,0,0,12"/>
         <Button Content="Cerrar caja" Click="BeginClosingClick" Visibility="{Binding HasOpenCash,Converter={StaticResource VisibleWhen}}" Style="{StaticResource DestructiveButton}" HorizontalAlignment="Left" MinWidth="220" MinHeight="52" Margin="0,0,0,12"/>
         <TextBlock Text="Salir del usuario o cerrar la aplicación no cierra la caja." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
        </StackPanel>
        <local:CashMovementsView DataContext="{Binding CashMovements}" Width="600" Margin="0,0,0,24" Visibility="{Binding DataContext.ShowCashMovements,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}"/>
        </WrapPanel>
        <StackPanel Visibility="{Binding IsUsers,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}">
         <TextBlock Text="Usuarios registrados" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
         <DataGrid x:Name="UserList" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Height="220" AutomationProperties.Name="Usuarios">
          <DataGrid.Columns><DataGridTextColumn Header="Usuario" Binding="{Binding Username,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Rol" Binding="{Binding Role,Mode=OneWay}" Width="140"/><DataGridTextColumn Header="Estado" Binding="{Binding Status,Mode=OneWay}" Width="200"/></DataGrid.Columns>
         </DataGrid>
         <Grid Margin="0,14,0,0" IsEnabled="{Binding CanEditSelectedUser}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Nombre del usuario seleccionado" FontSize="14" FontWeight="SemiBold"/><TextBox Text="{Binding EditUserDisplay,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nombre del usuario seleccionado" Margin="0,6,0,8"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Rol" FontSize="14" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding RoleOptions}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding EditUserRole}" AutomationProperties.Name="Rol del usuario seleccionado" Margin="0,6,0,8"/></StackPanel>
         </Grid>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="Guardar cambios" Click="SaveUserClick" IsEnabled="{Binding CanEditSelectedUser}" Margin="0,0,12,8" AutomationProperties.Name="Guardar cambios del usuario seleccionado"/>
          <Button Content="{Binding ToggleUserText}" Click="ToggleUserClick" IsEnabled="{Binding CanEditSelectedUser}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" AutomationProperties.Name="Desactivar o reactivar usuario"/>
          <Button Content="Restablecer contraseña" Click="ResetPasswordClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" AutomationProperties.Name="Restablecer contraseña del usuario seleccionado"/>
         </WrapPanel>
         <TextBlock Text="El administrador no se edita aquí. Si olvida su contraseña, se recupera en este equipo con: CasaMiga.Maintenance reset-admin &lt;carpeta de datos&gt;" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Padding="16,12" Margin="0,4,0,8" Visibility="{Binding HasTemporaryPasswordNotice,Converter={StaticResource VisibleWhen}}">
          <TextBox Text="{Binding TemporaryPasswordNotice,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="16" AutomationProperties.Name="Contraseña temporal"/>
         </Border>
         <TextBlock Text="Nuevo usuario" Style="{StaticResource SectionTitleText}" Margin="0,18,0,10"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Usuario" FontSize="14" FontWeight="SemiBold"/><TextBox Text="{Binding NewUserName,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Usuario nuevo" Margin="0,6,0,8"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Nombre para mostrar" FontSize="14" FontWeight="SemiBold"/><TextBox Text="{Binding NewUserDisplay,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nombre del usuario nuevo" Margin="0,6,0,8"/></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Text="Rol" FontSize="14" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding RoleOptions}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding NewUserRole}" AutomationProperties.Name="Rol del usuario nuevo" Margin="0,6,0,8"/></StackPanel>
         </Grid>
         <TextBlock Text="Se genera una contraseña temporal; el usuario debe cambiarla en su primer acceso." Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
         <WrapPanel><Button Content="Crear usuario" Click="CreateUserClick" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsOpening,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}" MaxWidth="520" HorizontalAlignment="Left">
         <TextBlock Text="Fondo inicial en MXN" FontSize="14" FontWeight="SemiBold"/><TextBox x:Name="OpeningAmount" AutomationProperties.Name="Fondo inicial en MXN" Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" FontSize="22" Margin="0,8,0,8"/>
         <TextBlock Text="Ejemplo: 500.00 · Se permite iniciar con $0.00" Style="{StaticResource CaptionText}" Margin="0,0,0,24"/>
         <WrapPanel><Button Content="Cancelar" Click="CancelOpeningClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button Content="Confirmar apertura" Click="OpenClick" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsCounting,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}" MaxWidth="520" HorizontalAlignment="Left">
         <TextBlock Text="{Binding ClosingOwner}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/><TextBlock Text="Efectivo contado en MXN" FontSize="14" FontWeight="SemiBold"/><TextBox x:Name="CountedInput" AutomationProperties.Name="Efectivo contado en MXN" Text="{Binding CountedAmount,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" FontSize="22" Margin="0,8,0,24"/>
         <WrapPanel><Button Content="Cancelar" Click="BackClosingClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button Content="Continuar" Click="SubmitCountClick" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsClosingResult,Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding IsReady}" MaxWidth="640" HorizontalAlignment="Left">
         <TextBlock Text="{Binding ClosingOwner}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
         <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="14" Padding="20,16" Margin="0,0,0,20"><TextBlock Text="{Binding ClosingDetails}" FontSize="20" LineHeight="30"/></Border>
         <TextBlock Text="La sesión quedará cerrada y auditada. No podrá volver a abrirse. Volver conserva el conteo confirmado." Margin="0,0,0,24"/>
         <WrapPanel><Button x:Name="BackResult" Content="Volver" Click="BackClosingClick" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button Content="Confirmar cierre" Click="ConfirmCloseClick" Style="{StaticResource DestructiveButton}" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <TextBlock Text="{Binding Message}" Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Message}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel>
      </Border>
     </ScrollViewer>
     <local:PosView DataContext="{Binding Pos}" Visibility="{Binding DataContext.IsPos,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource VisibleWhen}}" CashRequested="PosCashRequested" CatalogRequested="PosCatalogRequested" SalesRequested="PosSalesRequested" InventoryRequested="PosInventoryRequested" RecipesRequested="PosRecipesRequested" ProductionRequested="PosProductionRequested" LogoutRequested="PosLogoutRequested"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
