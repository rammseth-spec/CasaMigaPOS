<UserControl x:Class="CasaMiga.Presentation.PasswordInput" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="False" Focusable="False">
 <Grid>
  <!-- Padding derecho deja espacio al botón del ojo. Sólo uno de los dos campos es visible. -->
  <PasswordBox x:Name="Hidden" Padding="12,8,50,8" PasswordChanged="HiddenChanged"/>
  <TextBox x:Name="Plain" Padding="12,8,50,8" Visibility="Collapsed" IsUndoEnabled="False" ContextMenu="{x:Null}" TextChanged="PlainChanged"/>
  <ToggleButton x:Name="Reveal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Width="40" Height="34" Cursor="Hand"
                Checked="RevealChanged" Unchecked="RevealChanged" ToolTip="Mostrar contraseña" AutomationProperties.Name="Mostrar contraseña">
   <ToggleButton.Template>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Chip" Background="Transparent" CornerRadius="6">
      <Grid Width="22" Height="16">
       <!-- Ojo -->
       <Path Data="M1,8 C4,2 18,2 21,8 C18,14 4,14 1,8 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
       <Ellipse Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}"/>
       <!-- Tachado cuando la contraseña está visible -->
       <Path x:Name="Slash" Data="M3,15 L19,1" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Slash" Property="Visibility" Value="Visible"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </ToggleButton.Template>
  </ToggleButton>
 </Grid>
</UserControl>
