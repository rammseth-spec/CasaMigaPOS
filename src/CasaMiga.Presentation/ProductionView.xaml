<UserControl x:Class="CasaMiga.Presentation.ProductionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CasaMiga.Presentation" local:NestedScrollBehavior.IsEnabled="True">
 <StackPanel IsEnabled="{Binding Ready}">
  <StackPanel Visibility="{Binding IsHome,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Selecciona una acción" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button Content="Nueva producción" Click="NewClick" Visibility="{Binding CanCreate,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,8"/><Button Content="Producciones en borrador" Click="DraftsClick" Margin="0,0,8,8"/><Button Content="Historial" Click="HistoryClick" Margin="0,0,8,8"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsBuilder,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Nueva producción" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Agrega productos y cantidades. El stock del cálculo es informativo; se validará otra vez al confirmar." Margin="0,6,0,12"/>
   <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Profiles.Count}" Text="No hay perfiles productivos activos."/><DataGrid ItemsSource="{Binding Plan}" SelectedItem="{Binding SelectedPlan}" IsReadOnly="False" Height="210"><DataGrid.Columns><DataGridTemplateColumn Header="Producto / perfil activo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Profiles,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Profile}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad planeada" Binding="{Binding Planned,UpdateSourceTrigger=PropertyChanged}" Width="190"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,8"><Button Content="Agregar producto" Click="AddOutputClick" IsEnabled="{Binding HasProfiles}" Margin="0,0,8,0"/><Button Content="Quitar seleccionado" Click="RemoveOutputClick" IsEnabled="{Binding CanRemoveOutput}" Margin="0,0,8,0"/><Button Content="Calcular necesidades" Click="PreviewClick" IsEnabled="{Binding CanCalculate}"/></WrapPanel>
   <ItemsControl ItemsSource="{Binding Alternatives}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <StackPanel Visibility="{Binding PreviewReady,Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0"><TextBlock Text="Preparaciones requeridas" FontSize="20" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding FormulaRows}" Height="130"><DataGrid.Columns><DataGridTextColumn Header="Preparación" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Required}" Width="160"/></DataGrid.Columns></DataGrid><TextBlock Text="Insumos y stock" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><DataGrid ItemsSource="{Binding RequirementRows}" Height="210"><DataGrid.Columns><DataGridTextColumn Header="Insumo" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Necesario" Binding="{Binding Required}" Width="130"/><DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="160"/></DataGrid.Columns></DataGrid></StackPanel>
   <TextBlock Text="{Binding PreviewState}" Margin="0,10" FontWeight="SemiBold"/><WrapPanel><Button Content="Cancelar" Click="BackClick" Margin="0,0,8,0"/><Button Content="Crear producción" Click="CreateClick" IsEnabled="{Binding CanCreateDraft}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsDrafts,Converter={StaticResource VisibleWhen}}"><TextBlock Text="Producciones en borrador" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Los planes creados no pueden modificarse. Para cambiar cantidades crea una nueva producción." Margin="0,6,0,12"/><TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Rows.Count}" Text="{Binding EmptyRowsMessage}"/><DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="145"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Creado por" Binding="{Binding Creator}" Width="180"/><DataGridTextColumn Header="Terminal" Binding="{Binding Terminal}" Width="190"/><DataGridTextColumn Header="Productos" Binding="{Binding Products}" Width="320"/><DataGridTextColumn Header="Planeado/real" Binding="{Binding Result}" Width="180"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12"><Button Content="Volver" Click="BackClick" Margin="0,0,8,0"/><Button Content="Ver detalle" Click="OpenClick" IsEnabled="{Binding CanOpenDetail}"/></WrapPanel></StackPanel>
  <StackPanel Visibility="{Binding IsHistory,Converter={StaticResource VisibleWhen}}"><TextBlock Text="Historial de producción" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Consulta histórica de sólo lectura." Margin="0,6,0,12"/><TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Rows.Count}" Text="{Binding EmptyRowsMessage}"/><DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="145"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Creado por" Binding="{Binding Creator}" Width="180"/><DataGridTextColumn Header="Terminal" Binding="{Binding Terminal}" Width="190"/><DataGridTextColumn Header="Productos" Binding="{Binding Products}" Width="320"/><DataGridTextColumn Header="Planeado/real" Binding="{Binding Result}" Width="180"/><DataGridCheckBoxColumn Header="Sin salida" Binding="{Binding ZeroOutput}" Width="100"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,12"><Button Content="Volver" Click="BackClick" Margin="0,0,8,0"/><Button Content="Ver detalle" Click="OpenClick" IsEnabled="{Binding CanOpenDetail}"/></WrapPanel></StackPanel>
  <StackPanel Visibility="{Binding IsDetail,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{Binding DetailHeader}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding DetailContext}" Margin="0,6,0,10"/><TextBlock Text="{Binding ConfirmationRestriction}" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock Text="Productos" FontSize="20" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding DetailProducts}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="Preparaciones utilizadas" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><ItemsControl ItemsSource="{Binding DetailFormulas}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="Ingredientes consumidos" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><ItemsControl ItemsSource="{Binding DetailInputs}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <StackPanel Visibility="{Binding DetailIsDraft,Converter={StaticResource VisibleWhen}}"><TextBlock Text="Resultado real" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,4"/><DataGrid ItemsSource="{Binding Actuals}" IsReadOnly="False" Height="190"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Planeado" Binding="{Binding Planned}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Real obtenido" Binding="{Binding Actual}" Width="130"/><DataGridTextColumn Header="Comparación" Binding="{Binding Difference}" IsReadOnly="True" Width="190"/></DataGrid.Columns></DataGrid><Button Content="Confirmar producción" Click="ConfirmClick" IsEnabled="{Binding CanConfirmDetail}" Margin="0,10,0,0"/></StackPanel>
   <Button Content="Volver" Click="BackClick" Margin="0,12,0,0" HorizontalAlignment="Left"/>
  </StackPanel>
  <TextBlock Text="{Binding Message}" Margin="0,14,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel>
</UserControl>
