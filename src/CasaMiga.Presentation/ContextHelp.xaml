<UserControl x:Class="CasaMiga.Presentation.ContextHelp" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="HelpRoot" PreviewKeyDown="HelpKeyDown">
 <Expander x:Name="HelpPanel" Header="?" AutomationProperties.Name="Ayuda contextual" ToolTip="Mostrar ayuda" MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Top">
  <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0">
   <TextBlock Text="{Binding HelpText,ElementName=HelpRoot}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
  </Border>
 </Expander>
</UserControl>
