<UserControl x:Class="CasaMiga.Presentation.ContextHelp"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="HelpRoot" HorizontalAlignment="Left" VerticalAlignment="Center"
 Loaded="HelpLoaded" Unloaded="HelpUnloaded" PreviewKeyDown="HelpKeyDown">
 <Grid>
  <Button x:Name="HelpButton" Content="?" Click="HelpButtonClick"
   Style="{StaticResource SecondaryButton}" MinWidth="32" MinHeight="32" Width="32" Height="32" Padding="0"
   FontSize="15" FontWeight="Bold" AutomationProperties.Name="{Binding Label,ElementName=HelpRoot}"
   ToolTip="{Binding Label,ElementName=HelpRoot}"/>
  <Popup x:Name="HelpPopup" Placement="Relative" PlacementTarget="{Binding ElementName=HelpButton}"
   AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Opened="HelpPopupOpened" Closed="HelpPopupClosed">
   <Border x:Name="PopupCard" Focusable="True" PreviewKeyDown="HelpKeyDown"
    Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="1" CornerRadius="10" Padding="14,12">
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#4B2E19"/></Border.Effect>
    <TextBlock Text="{Binding HelpText,ElementName=HelpRoot}" TextWrapping="Wrap"
     Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="22"/>
   </Border>
  </Popup>
 </Grid>
</UserControl>
