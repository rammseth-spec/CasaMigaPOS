<UserControl x:Class="CasaMiga.Presentation.RecipeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CasaMiga.Presentation" local:NestedScrollBehavior.IsEnabled="True">
 <StackPanel IsEnabled="{Binding Ready}">
  <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="{Binding ModeLabel}" Foreground="{DynamicResource MutedBrush}"/><WrapPanel><Button Content="Recetas" Style="{StaticResource SectionTabButton}" Tag="{Binding IsList}" Click="FormulasClick" Margin="0,0,8,0"/><Button Content="Perfiles de producto" Style="{StaticResource SectionTabButton}" Tag="{Binding IsProfiles}" Click="ProfilesClick"/></WrapPanel></DockPanel>
  <StackPanel Visibility="{Binding IsList,Converter={StaticResource VisibleWhen}}">
   <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Formulas.Count}" Text="No hay recetas registradas."/>
   <DataGrid ItemsSource="{Binding Formulas}" SelectedItem="{Binding SelectedFormula}" Height="360" AutomationProperties.Name="Recetas" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="150" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Versión activa" Binding="{Binding ActiveVersion}" Width="150" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Borrador disponible" Binding="{Binding Draft}" Width="160" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Nueva receta" Click="NewFormulaClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Ver detalle" Click="OpenFormulaClick" Style="{StaticResource SelectionRequiredButton}" Tag="{Binding SelectedFormula}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsFormula,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Code}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8"/><local:ContextHelp Label="Ayuda de versiones" HelpText="{Binding PublishedNotice}" Margin="0,0,0,12"/>
   <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Versions.Count}" Text="No hay versiones registradas. Crea la primera versión para definir su fórmula."/>
   <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Height="280" AutomationProperties.Name="Versiones de la receta" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Versión" Binding="{Binding VersionLabel}" Width="120" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Estado" Binding="{Binding DisplayState}" Width="170" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Volver" Click="BackClick" Margin="0,0,8,0"/><Button Content="Crear nueva versión" Click="NewFormulaVersionClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Editar borrador" Click="EditFormulaVersionClick" IsEnabled="{Binding CanEditSelectedVersion}" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Publicar versión" Click="PublishFormulaClick" IsEnabled="{Binding CanEditSelectedVersion}" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Activar versión" Click="ActivateFormulaClick" IsEnabled="{Binding CanActivateSelectedVersion}" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsFormulaEditor,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Receta" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <Grid Visibility="{Binding IsNewFormulaOwner,Converter={StaticResource VisibleWhen}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Código"/><TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Código de receta"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Nombre de la receta"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre de receta"/></StackPanel></Grid>
   <StackPanel Visibility="{Binding CanSaveFormulaVersion,Converter={StaticResource VisibleWhen}}">
    <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Versión"/><TextBox Text="{Binding VersionNumber}" IsReadOnly="True" AutomationProperties.Name="Número de versión automático"/><TextBlock Text="Nombre de esta versión" Margin="0,8,0,0"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Notas (opcional)" Margin="0,8,0,0"/><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><WrapPanel><TextBlock Text="Rendimiento"/><local:ContextHelp Label="Ayuda de rendimiento" HelpText="{Binding YieldHelpText}" Margin="8,-4,0,0"/></WrapPanel><TextBox Text="{Binding Yield,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Dimensión" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Dimensions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding YieldDimension}" AutomationProperties.Name="Dimensión del rendimiento"/><TextBlock Text="Unidad" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding YieldUnitChoices}" SelectedItem="{Binding YieldUnit}" AutomationProperties.Name="Unidad del rendimiento"/></StackPanel></Grid></Border>
    <TextBlock Text="Buscar ingrediente" FontWeight="SemiBold"/><Grid Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding IngredientSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar ingrediente por nombre o código"/><Button Grid.Column="1" Content="× Limpiar" Click="ClearIngredientSearchClick" IsEnabled="{Binding HasIngredientSearch}" Margin="8,0,0,0"/></Grid>
    <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding IngredientMatches.Count}" Text="{Binding IngredientEmptyMessage}" Margin="0,0,0,8"/>
    <WrapPanel Margin="0,6,0,6"><TextBlock Text="Ingredientes directos de la receta" FontSize="21" FontWeight="SemiBold"/><local:ContextHelp Label="Ayuda de ingredientes directos" HelpText="{Binding DirectIngredientsHelpText}" Margin="8,-2,0,0"/></WrapPanel>
    <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Ingredients.Count}" Text="Aún no hay ingredientes directos en esta versión."/>
    <DataGrid ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelectedIngredient}" IsReadOnly="False" Height="180" AutomationProperties.Name="Ingredientes directos de receta" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTemplateColumn Header="Ingrediente" Width="*" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding Item,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seleccionar ingrediente"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource CasaMigaTableCenteredTextStyle}" EditingElementStyle="{StaticResource CasaMigaTableNumericEditorStyle}" HeaderStyle="{StaticResource CasaMigaTableCenteredHeaderStyle}"/><DataGridTemplateColumn Header="Unidad" Width="100" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding Unit,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Width="230"><DataGridTemplateColumn.Header><WrapPanel><TextBlock Text="Política de cantidad" VerticalAlignment="Center"/><local:ContextHelp Label="Ayuda de política de cantidad" HelpText="{Binding DataContext.PolicyHelpText,RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="6,0,0,0"/></WrapPanel></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailablePolicies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Policy,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <WrapPanel Margin="0,6"><Button Content="Agregar ingrediente" Click="AddIngredientClick" IsEnabled="{Binding CanAddIngredient}" Margin="0,0,8,0"/><Button Content="Quitar ingrediente" Click="RemoveIngredientClick" IsEnabled="{Binding CanRemoveIngredient}"/></WrapPanel>
    <WrapPanel Margin="0,14,0,6"><TextBlock Text="Grupos de alternativas" FontSize="21" FontWeight="SemiBold"/><local:ContextHelp Label="Ayuda de grupos de alternativas" HelpText="{Binding AlternativesHelpText}" Margin="8,-2,0,0"/></WrapPanel>
    <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Alternatives.Count}" Text="Aún no hay grupos de alternativas. Crea uno sólo cuando varios ingredientes puedan sustituirse."/>
    <DataGrid ItemsSource="{Binding Alternatives}" SelectedItem="{Binding SelectedAlternative}" IsReadOnly="False" Height="210" AutomationProperties.Name="Grupos y opciones de alternativas" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Grupo" Binding="{Binding GroupLabel}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Orden" Binding="{Binding OptionLabel}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTemplateColumn Header="Ingrediente alternativo" Width="*" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding Item,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seleccionar opción alternativa"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource CasaMigaTableCenteredTextStyle}" EditingElementStyle="{StaticResource CasaMigaTableNumericEditorStyle}" HeaderStyle="{StaticResource CasaMigaTableCenteredHeaderStyle}"/><DataGridTemplateColumn Header="Unidad" Width="90" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding Unit,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Width="210"><DataGridTemplateColumn.Header><WrapPanel><TextBlock Text="Política de cantidad" VerticalAlignment="Center"/><local:ContextHelp Label="Ayuda de política de cantidad" HelpText="{Binding DataContext.PolicyHelpText,RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="6,0,0,0"/></WrapPanel></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailablePolicies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Policy,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <WrapPanel Margin="0,6"><Button Content="Nuevo grupo de alternativas" Click="AddAlternativeClick" IsEnabled="{Binding CanAddIngredient}" Margin="0,0,8,0"/><Button Content="Agregar opción al grupo" Click="AddAlternativeOptionClick" IsEnabled="{Binding CanAddAlternativeOption}" Margin="0,0,8,0"/><Button Content="Quitar opción" Click="RemoveAlternativeClick" IsEnabled="{Binding CanRemoveAlternative}"/></WrapPanel>
   </StackPanel>
   <WrapPanel Margin="0,14,0,0"><Button Content="Cancelar" Click="BackClick" Margin="0,0,8,0"/><Button Content="Crear receta" Click="CreateFormulaClick" IsEnabled="{Binding CanCreateFormula}" Visibility="{Binding IsNewFormulaOwner,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Guardar borrador" Click="SaveFormulaVersionClick" IsEnabled="{Binding CanSaveFormulaDraft}" Visibility="{Binding CanSaveFormulaVersion,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProfiles,Converter={StaticResource VisibleWhen}}">
   <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Profiles.Count}" Text="No hay perfiles de producto registrados."/><DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Height="360" AutomationProperties.Name="Perfiles de producto" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="*" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Artículo terminado" Binding="{Binding FinishedItem}" Width="*" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Versión activa" Binding="{Binding ActiveVersion}" Width="140" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Borrador" Binding="{Binding Draft}" Width="100" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Nuevo perfil" Click="NewProfileClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Ver detalle" Click="OpenProfileClick" Style="{StaticResource SelectionRequiredButton}" Tag="{Binding SelectedProfile}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProfile,Converter={StaticResource VisibleWhen}}">
    <TextBlock Text="Perfil productivo" FontSize="24" FontWeight="SemiBold"/><local:ContextHelp Label="Ayuda de versiones" HelpText="{Binding PublishedNotice}" Margin="0,6,0,12"/><TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding Versions.Count}" Text="No hay versiones registradas. Crea la primera versión del perfil."/><DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Height="280" AutomationProperties.Name="Versiones del perfil" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="Versión" Binding="{Binding VersionLabel}" Width="120" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/><DataGridTextColumn Header="Estado" Binding="{Binding DisplayState}" Width="170" ElementStyle="{StaticResource CasaMigaTableTextStyle}" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Volver" Click="BackClick" Margin="0,0,8,0"/><Button Content="Crear nueva versión" Click="NewProfileVersionClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Editar borrador" Click="EditProfileVersionClick" IsEnabled="{Binding CanEditSelectedVersion}" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Publicar versión" Click="PublishProfileClick" IsEnabled="{Binding CanEditSelectedVersion}" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Activar versión" Click="ActivateProfileClick" IsEnabled="{Binding CanActivateSelectedVersion}" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProfileEditor,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Perfil productivo" FontSize="24" FontWeight="SemiBold"/>
   <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Producto"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding ProfileProduct}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Artículo terminado"/><ComboBox ItemsSource="{Binding FinishedItems}" SelectedItem="{Binding ProfileFinishedItem}"/></StackPanel></Grid>
   <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding FinishedItems.Count}" Text="No hay artículos terminados disponibles. Crea primero un artículo de tipo Producto terminado en Inventario."/>
   <StackPanel Visibility="{Binding CanSaveProfileVersion,Converter={StaticResource VisibleWhen}}"><TextBlock Text="Versión" Margin="0,8,0,0"/><TextBox Text="{Binding VersionNumber}" IsReadOnly="True"/><TextBlock Text="Nombre de esta versión" Margin="0,8,0,0"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Visibility="{Binding CanSaveProfileVersion,Converter={StaticResource VisibleWhen}}">
     <WrapPanel Margin="0,16,0,6"><TextBlock Text="Preparaciones por pieza" FontSize="21" FontWeight="SemiBold"/><local:ContextHelp Label="Ayuda de preparaciones por pieza" HelpText="{Binding PreparationsHelpText}" Margin="8,-2,0,0"/></WrapPanel>
    <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding FormulaRequirements.Count}" Text="Aún no hay preparaciones en este perfil."/>
    <DataGrid ItemsSource="{Binding FormulaRequirements}" SelectedItem="{Binding SelectedFormulaRequirement}" IsReadOnly="False" Height="180" AutomationProperties.Name="Preparaciones del perfil" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTemplateColumn Header="Preparación publicada" Width="*" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.PublishedFormulas,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Formula,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad por pieza" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="150" ElementStyle="{StaticResource CasaMigaTableCenteredTextStyle}" EditingElementStyle="{StaticResource CasaMigaTableNumericEditorStyle}" HeaderStyle="{StaticResource CasaMigaTableCenteredHeaderStyle}"/><DataGridTemplateColumn Header="Unidad compatible" Width="150" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding Unit,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <WrapPanel Margin="0,6"><Button Content="Agregar preparación" Click="AddFormulaRequirementClick" IsEnabled="{Binding CanAddPreparation}" Margin="0,0,8,0"/><Button Content="Quitar preparación" Click="RemoveFormulaRequirementClick" IsEnabled="{Binding CanRemovePreparation}"/></WrapPanel>
     <WrapPanel Margin="0,14,0,6"><TextBlock Text="Ingredientes directos por pieza" FontSize="21" FontWeight="SemiBold"/><local:ContextHelp Label="Ayuda de ingredientes directos" HelpText="{Binding DirectIngredientsHelpText}" Margin="8,-2,0,0"/></WrapPanel>
    <TextBlock Text="Buscar ingrediente" FontWeight="SemiBold"/><Grid Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding IngredientSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar ingrediente directo por nombre o código"/><Button Grid.Column="1" Content="× Limpiar" Click="ClearIngredientSearchClick" IsEnabled="{Binding HasIngredientSearch}" Margin="8,0,0,0"/></Grid>
    <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding IngredientMatches.Count}" Text="{Binding IngredientEmptyMessage}" Margin="0,0,0,8"/>
    <TextBlock Style="{StaticResource EmptyStateText}" Tag="{Binding DirectIngredients.Count}" Text="Aún no hay ingredientes directos en este perfil."/>
     <DataGrid ItemsSource="{Binding DirectIngredients}" SelectedItem="{Binding SelectedDirect}" IsReadOnly="False" Height="180" AutomationProperties.Name="Ingredientes directos del perfil" CanUserResizeColumns="False" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTemplateColumn Header="Ingrediente" Width="*" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding Item,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad por pieza" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="150" ElementStyle="{StaticResource CasaMigaTableCenteredTextStyle}" EditingElementStyle="{StaticResource CasaMigaTableNumericEditorStyle}" HeaderStyle="{StaticResource CasaMigaTableCenteredHeaderStyle}"/><DataGridTemplateColumn Header="Unidad compatible" Width="150" HeaderStyle="{StaticResource CasaMigaTableTextHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding Unit,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Width="220"><DataGridTemplateColumn.Header><WrapPanel><TextBlock Text="Política de cantidad" VerticalAlignment="Center"/><local:ContextHelp Label="Ayuda de política de cantidad" HelpText="{Binding DataContext.PolicyHelpText,RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="6,0,0,0"/></WrapPanel></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailablePolicies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Policy,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <WrapPanel Margin="0,6"><Button Content="Agregar ingrediente directo" Click="AddDirectClick" IsEnabled="{Binding CanAddIngredient}" Margin="0,0,8,0"/><Button Content="Quitar ingrediente directo" Click="RemoveDirectClick" IsEnabled="{Binding CanRemoveDirect}"/></WrapPanel>
   </StackPanel>
   <WrapPanel Margin="0,14,0,0"><Button Content="Cancelar" Click="BackClick" Margin="0,0,8,0"/><Button Content="Crear perfil" Click="CreateProfileClick" IsEnabled="{Binding CanCreateProfile}" Visibility="{Binding IsNewProfileOwner,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Guardar borrador" Click="SaveProfileVersionClick" IsEnabled="{Binding CanSaveProfileDraft}" Visibility="{Binding CanSaveProfileVersion,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding Message}" Margin="0,14,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel>
</UserControl>
