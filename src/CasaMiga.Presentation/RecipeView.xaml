<UserControl x:Class="CasaMiga.Presentation.RecipeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel IsEnabled="{Binding Ready}">
  <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Text="{Binding ModeLabel}" Foreground="{DynamicResource MutedBrush}"/><WrapPanel><Button Content="Recetas" Click="FormulasClick" Margin="0,0,8,0"/><Button Content="Perfiles de producto" Click="ProfilesClick"/></WrapPanel></DockPanel>
  <StackPanel Visibility="{Binding IsList,Converter={StaticResource VisibleWhen}}">
   <DataGrid ItemsSource="{Binding Formulas}" SelectedItem="{Binding SelectedFormula}" Height="360" AutomationProperties.Name="Recetas"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="150"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Versión activa" Binding="{Binding ActiveVersion}" Width="150"/><DataGridTextColumn Header="Borrador disponible" Binding="{Binding Draft}" Width="160"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Nueva receta" Click="NewFormulaClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Ver detalle" Click="OpenFormulaClick"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsFormula,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Code}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8"/><TextBlock Text="{Binding PublishedNotice}" Margin="0,0,0,12"/>
   <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Height="280"><DataGrid.Columns><DataGridTextColumn Header="Versión" Binding="{Binding Number}" Width="90"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="130"/><DataGridCheckBoxColumn Header="Activa" Binding="{Binding Active}" Width="80"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Volver" Click="BackClick" Margin="0,0,8,0"/><Button Content="Nueva versión" Click="NewFormulaVersionClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Editar borrador" Click="EditFormulaVersionClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Publicar" Click="PublishFormulaClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Activar" Click="ActivateFormulaClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsFormulaEditor,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Editor de receta" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Código"/><TextBox Text="{Binding Code}"/><TextBlock Text="Nombre" Margin="0,8,0,0"/><TextBox Text="{Binding Name}"/><TextBlock Text="Notas" Margin="0,8,0,0"/><TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="80"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Versión"/><TextBox Text="{Binding VersionNumber}"/><TextBlock Text="Rendimiento" Margin="0,8,0,0"/><TextBox Text="{Binding Yield}"/><TextBlock Text="Dimensión" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Dimensions}" SelectedItem="{Binding YieldDimension}"/><TextBlock Text="Unidad: g/kg, ml/L o pieza" Margin="0,8,0,0"/><TextBox Text="{Binding YieldUnit}"/></StackPanel></Grid>
   <TextBlock Text="Ingredientes normales" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,6"/><DataGrid ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelectedIngredient}" IsReadOnly="False" Height="180"><DataGrid.Columns><DataGridTemplateColumn Header="Artículo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Items,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Item,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="Unidad" Binding="{Binding Unit,UpdateSourceTrigger=PropertyChanged}" Width="90"/><DataGridTemplateColumn Header="Política" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.PolicyChoices,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Policy}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,6"><Button Content="Agregar ingrediente" Click="AddIngredientClick" Margin="0,0,8,0"/><Button Content="Quitar seleccionado" Click="RemoveIngredientClick"/></WrapPanel>
   <TextBlock Text="Alternativas · usa el mismo número de grupo; preferencia 1 se intenta primero" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,6"/><DataGrid ItemsSource="{Binding Alternatives}" SelectedItem="{Binding SelectedAlternative}" IsReadOnly="False" Height="190"><DataGrid.Columns><DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="80"/><DataGridTemplateColumn Header="Opción" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Items,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Item}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="80"/><DataGridTemplateColumn Header="Política" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.PolicyChoices,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Policy}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Preferencia" Binding="{Binding Preference}" Width="100"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,6"><Button Content="Agregar grupo/opción" Click="AddAlternativeClick" Margin="0,0,8,0"/><Button Content="Quitar opción" Click="RemoveAlternativeClick"/></WrapPanel>
   <WrapPanel Margin="0,12,0,0"><Button Content="Cancelar" Click="BackClick" Margin="0,0,8,0"/><Button Content="Crear receta" Click="CreateFormulaClick" Visibility="{Binding IsNewFormulaOwner,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Guardar borrador" Click="SaveFormulaVersionClick" Visibility="{Binding CanSaveFormulaVersion,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProfiles,Converter={StaticResource VisibleWhen}}">
   <DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Artículo terminado" Binding="{Binding FinishedItem}" Width="*"/><DataGridTextColumn Header="Versión activa" Binding="{Binding ActiveVersion}" Width="140"/><DataGridTextColumn Header="Borrador" Binding="{Binding Draft}" Width="100"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Nuevo perfil" Click="NewProfileClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Ver detalle" Click="OpenProfileClick"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProfile,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Perfil productivo" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding PublishedNotice}" Margin="0,6,0,12"/><DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Height="280"><DataGrid.Columns><DataGridTextColumn Header="Versión" Binding="{Binding Number}" Width="90"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="130"/><DataGridCheckBoxColumn Header="Activa" Binding="{Binding Active}" Width="80"/></DataGrid.Columns></DataGrid>
   <WrapPanel Margin="0,12,0,0"><Button Content="Volver" Click="BackClick" Margin="0,0,8,0"/><Button Content="Nueva versión" Click="NewProfileVersionClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Editar borrador" Click="EditProfileVersionClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Publicar" Click="PublishProfileClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Activar" Click="ActivateProfileClick" Visibility="{Binding CanConfigure,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <StackPanel Visibility="{Binding IsProfileEditor,Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="Editor de perfil productivo" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Producto" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding ProfileProduct}"/><TextBlock Text="Artículo terminado" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding FinishedItems}" SelectedItem="{Binding ProfileFinishedItem}"/><TextBlock Text="Versión" Margin="0,8,0,0"/><TextBox Text="{Binding VersionNumber}"/><TextBlock Text="Nombre" Margin="0,8,0,0"/><TextBox Text="{Binding Name}"/>
   <TextBlock Text="Preparaciones por pieza" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,6"/><DataGrid ItemsSource="{Binding FormulaRequirements}" SelectedItem="{Binding SelectedFormulaRequirement}" IsReadOnly="False" Height="170"><DataGrid.Columns><DataGridTemplateColumn Header="Fórmula publicada" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.PublishedFormulas,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Formula}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="110"/><DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="90"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,6"><Button Content="Agregar preparación" Click="AddFormulaRequirementClick" Margin="0,0,8,0"/><Button Content="Quitar" Click="RemoveFormulaRequirementClick"/></WrapPanel>
   <TextBlock Text="Ingredientes directos por pieza" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,6"/><DataGrid ItemsSource="{Binding DirectIngredients}" SelectedItem="{Binding SelectedDirect}" IsReadOnly="False" Height="170"><DataGrid.Columns><DataGridTemplateColumn Header="Artículo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Items,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Item}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="90"/><DataGridTemplateColumn Header="Política" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.PolicyChoices,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Policy}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><WrapPanel Margin="0,6"><Button Content="Agregar ingrediente" Click="AddDirectClick" Margin="0,0,8,0"/><Button Content="Quitar" Click="RemoveDirectClick"/></WrapPanel>
   <WrapPanel Margin="0,12,0,0"><Button Content="Cancelar" Click="BackClick" Margin="0,0,8,0"/><Button Content="Crear perfil" Click="CreateProfileClick" Visibility="{Binding IsNewProfileOwner,Converter={StaticResource VisibleWhen}}" Margin="0,0,8,0"/><Button Content="Guardar borrador" Click="SaveProfileVersionClick" Visibility="{Binding CanSaveProfileVersion,Converter={StaticResource VisibleWhen}}"/></WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding Message}" Margin="0,14,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding MessageIsSuccess}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel>
</UserControl>
